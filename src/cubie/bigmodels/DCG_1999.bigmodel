<?xml version="1.0"?>
<model name="DCG_1999" xmlns="http://www.bigmodel.org/bigmodel/1.0#" xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" xmlns:cmeta="http://www.bigmodel.org/metadata/1.0#">


<units name="millisecond">
      <unit prefix="milli" units="second"/>
   </units>
   <units name="per_second">
      <unit exponent="-1" units="second"/>
   </units>
   <units name="millivolt">
      <unit prefix="milli" units="volt"/>
   </units>
   <units name="per_millivolt">
      <unit exponent="-1" prefix="milli" units="volt"/>
   </units>
   <units name="per_millivolt_second">
      <unit exponent="-1" units="millivolt"/>
      <unit exponent="-1" units="second"/>
   </units>
   <units name="microS">
      <unit prefix="micro" units="siemens"/>
   </units>
   <units name="picoS">
      <unit prefix="pico" units="siemens"/>
   </units>
   <units name="microF">
      <unit prefix="micro" units="farad"/>
   </units>
   <units name="nanoA">
      <unit prefix="nano" units="ampere"/>
   </units>
   <units name="millimolar">
      <unit prefix="milli" units="mole"/>
      <unit exponent="-1" units="litre"/>
   </units>
   <units name="nanomolar">
      <unit prefix="nano" units="mole"/>
      <unit exponent="-1" units="litre"/>
   </units>
   <units name="microS_per_millimolar">
      <unit units="microS"/>
      <unit exponent="-1" units="millimolar"/>
   </units>
   <units name="nanoA_per_millimolar">
      <unit units="nanoA"/>
      <unit exponent="-1" units="millimolar"/>
   </units>
   <units name="nanoA_per_nanomolar_4">
      <unit units="nanoA"/>
      <unit exponent="-4" units="nanomolar"/>
   </units>
   <units name="millimolar_4">
      <unit exponent="4" units="millimolar"/>
   </units>
   <units name="joule_per_kilomole_kelvin">
      <unit units="joule"/>
      <unit exponent="-1" prefix="kilo" units="mole"/>
      <unit exponent="-1" units="kelvin"/>
   </units>
   <units name="coulomb_per_mole">
      <unit units="coulomb"/>
      <unit exponent="-1" units="mole"/>
   </units>
   <units name="mul_per_second">
      <unit prefix="micro" units="litre"/>
      <unit exponent="-1" units="second"/>
   </units>
   <units name="mm_cubed">
      <unit prefix="micro" units="litre"/>
   </units>
   <units name="millimolar_per_second">
      <unit units="millimolar"/>
      <unit exponent="-1" units="second"/>
   </units>
   <units name="per_millimolar_second">
      <unit exponent="-1" units="millimolar"/>
      <unit exponent="-1" units="second"/>
   </units>
   <units name="cm2_per_second">
      <unit exponent="2" prefix="centi" units="metre"/>
      <unit exponent="-1" units="second"/>
   </units>
   <units name="cm">
      <unit prefix="centi" units="metre"/>
   </units>
   <component name="environment">
      <variable name="time" public_interface="out" units="second"/>
   </component>
   <component name="outerboundary">
      <variable initial_value="-49.54105" name="V" public_interface="out" units="millivolt"/>
      <variable initial_value="8314.472" name="R" public_interface="out" units="joule_per_kilomole_kelvin"/>
      <variable initial_value="310" name="T" public_interface="out" units="kelvin"/>
      <variable initial_value="96485.3415" name="F" public_interface="out" units="coulomb_per_mole"/>
      <variable initial_value="5.5e-5" name="Cm" units="microF"/>
      <variable name="time" public_interface="in" units="second"/>
      <variable name="i_Cr" public_interface="in" units="nanoA"/>
      <variable name="i_Em_T" public_interface="in" units="nanoA"/>
      <variable name="i_Em_L" public_interface="in" units="nanoA"/>
      <variable name="i_Az" public_interface="in" units="nanoA"/>
      <variable name="i_f" public_interface="in" units="nanoA"/>
      <variable name="i_B" public_interface="in" units="nanoA"/>
      <variable name="i_CrAz" public_interface="in" units="nanoA"/>
      <variable name="i_CrEm" public_interface="in" units="nanoA"/>
      <variable name="i_Em_P" public_interface="in" units="nanoA"/>
      <variable name="i_Az_brakes" public_interface="in" units="nanoA"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>V</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <apply>
                     <plus/>
                     <ci>i_Cr</ci>
                     <ci>i_Em_T</ci>
                     <ci>i_Em_L</ci>
                     <ci>i_Az</ci>
                     <ci>i_f</ci>
                     <ci>i_B</ci>
                     <ci>i_CrAz</ci>
                     <ci>i_CrEm</ci>
                     <ci>i_Em_P</ci>
                     <ci>i_Az_brakes</ci>
                  </apply>
               </apply>
               <ci>Cm</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_flux">
      <variable name="i_Cr" public_interface="out" units="nanoA"/>
      <variable initial_value="0.00344" name="P_Cr" units="mul_per_second"/>
      <variable name="E_Cr" public_interface="in" units="millivolt"/>
      <variable name="Cr_c" public_interface="in" units="millimolar"/>
      <variable name="F_brakes_Cr" units="dimensionless"/>
      <variable name="brakes" public_interface="in" units="millimolar"/>
      <variable name="R" public_interface="in" units="joule_per_kilomole_kelvin"/>
      <variable name="F" public_interface="in" units="coulomb_per_mole"/>
      <variable name="T" public_interface="in" units="kelvin"/>
      <variable name="time" private_interface="out" public_interface="in" units="second"/>
      <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
      <variable name="m" private_interface="in" units="dimensionless"/>
      <variable name="h1" private_interface="in" units="dimensionless"/>
      <variable name="h2" private_interface="in" units="dimensionless"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>F_brakes_Cr</ci>
            <apply>
               <minus/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <divide/>
                  <ci>brakes</ci>
                  <apply>
                     <plus/>
                     <ci>brakes</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">1<sep/>-3</cn>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_Cr</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <ci>F_brakes_Cr</ci>
                        <ci>P_Cr</ci>
                        <apply>
                           <power/>
                           <ci>m</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        </apply>
                        <ci>h1</ci>
                        <ci>h2</ci>
                        <ci>Cr_c</ci>
                        <ci>V</ci>
                        <apply>
                           <power/>
                           <ci>F</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                        </apply>
                     </apply>
                     <apply>
                        <times/>
                        <ci>R</ci>
                        <ci>T</ci>
                     </apply>
                  </apply>
                  <apply>
                     <minus/>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <times/>
                              <apply>
                                 <minus/>
                                 <ci>V</ci>
                                 <ci>E_Cr</ci>
                              </apply>
                              <ci>F</ci>
                           </apply>
                           <apply>
                              <times/>
                              <ci>R</ci>
                              <ci>T</ci>
                           </apply>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  </apply>
               </apply>
               <apply>
                  <minus/>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <times/>
                           <ci>V</ci>
                           <ci>F</ci>
                        </apply>
                        <apply>
                           <times/>
                           <ci>R</ci>
                           <ci>T</ci>
                        </apply>
                     </apply>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_flux_m_gate">
      <variable initial_value="0.250113" name="m" public_interface="out" units="dimensionless"/>
      <variable name="m_infinity" units="dimensionless"/>
      <variable name="tau_m" units="second"/>
      <variable name="alpha_m" units="per_second"/>
      <variable name="beta_m" units="per_second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_m</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <apply>
                     <minus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt_second">824</cn>
                  </apply>
                  <apply>
                     <plus/>
                     <ci>V</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">51.9</cn>
                  </apply>
               </apply>
               <apply>
                  <minus/>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">51.9</cn>
                        </apply>
                        <apply>
                           <minus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">8.9</cn>
                        </apply>
                     </apply>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_m</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">32960</cn>
               <apply>
                  <exp/>
                  <apply>
                     <divide/>
                     <apply>
                        <plus/>
                        <ci>V</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">51.9</cn>
                     </apply>
                     <apply>
                        <minus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">8.9</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>m_infinity</ci>
            <apply>
               <divide/>
               <ci>alpha_m</ci>
               <apply>
                  <plus/>
                  <ci>alpha_m</ci>
                  <ci>beta_m</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>tau_m</ci>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <plus/>
                     <ci>alpha_m</ci>
                     <ci>beta_m</ci>
                  </apply>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="second">0.000015</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>m</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>m_infinity</ci>
                  <ci>m</ci>
               </apply>
               <ci>tau_m</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_flux_h_gate">
      <variable initial_value="0.001386897" name="h1" public_interface="out" units="dimensionless"/>
      <variable initial_value="0.002065463" name="h2" public_interface="out" units="dimensionless"/>
      <variable name="h1_infinity" units="dimensionless"/>
      <variable name="h2_infinity" units="dimensionless"/>
      <variable name="tau_h1" units="second"/>
      <variable name="tau_h2" units="second"/>
      <variable name="alpha_h1" units="per_second"/>
      <variable name="beta_h1" units="per_second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_h1</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">165</cn>
               <apply>
                  <exp/>
                  <apply>
                     <divide/>
                     <apply>
                        <plus/>
                        <ci>V</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">101.3</cn>
                     </apply>
                     <apply>
                        <minus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">12.6</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_h1</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">12360</cn>
               <apply>
                  <plus/>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">320</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">101.3</cn>
                           </apply>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">12.6</cn>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>h1_infinity</ci>
            <apply>
               <divide/>
               <ci>alpha_h1</ci>
               <apply>
                  <plus/>
                  <ci>alpha_h1</ci>
                  <ci>beta_h1</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>tau_h1</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <plus/>
                  <ci>alpha_h1</ci>
                  <ci>beta_h1</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>h2_infinity</ci>
            <ci>h1_infinity</ci>
         </apply>
         <apply>
            <eq/>
            <ci>tau_h2</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">20</cn>
               <ci>tau_h1</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>h1</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>h1_infinity</ci>
                  <ci>h1</ci>
               </apply>
               <ci>tau_h1</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>h2</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>h2_infinity</ci>
                  <ci>h2</ci>
               </apply>
               <ci>tau_h2</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="L_type_Em_conduit">
      <variable name="i_Em_L" public_interface="out" units="nanoA"/>
      <variable name="g_Em_L" units="microS"/>
      <variable initial_value="0.02115" name="g_Em_L_cont" units="microS"/>
      <variable name="F_cwave_EmL" units="dimensionless"/>
      <variable name="cwave" public_interface="in" units="millimolar"/>
      <variable initial_value="46.4" name="E_Em_L" units="millivolt"/>
      <variable name="time" private_interface="out" public_interface="in" units="second"/>
      <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
      <variable name="d_L" private_interface="in" units="dimensionless"/>
      <variable name="d_L_infinity" private_interface="in" units="dimensionless"/>
      <variable name="f_L" private_interface="in" units="dimensionless"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>F_cwave_EmL</ci>
            <apply>
               <plus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.4</cn>
                  <apply>
                     <plus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <apply>
                        <divide/>
                        <apply>
                           <times/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">4.5</cn>
                           <ci>cwave</ci>
                        </apply>
                        <apply>
                           <plus/>
                           <ci>cwave</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">6.5<sep/>-3</cn>
                        </apply>
                     </apply>
                  </apply>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.03157</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>g_Em_L</ci>
            <apply>
               <times/>
               <ci>g_Em_L_cont</ci>
               <ci>F_cwave_EmL</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_Em_L</ci>
            <apply>
               <times/>
               <ci>g_Em_L</ci>
               <apply>
                  <plus/>
                  <apply>
                     <times/>
                     <ci>f_L</ci>
                     <ci>d_L</ci>
                  </apply>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.095</cn>
                     <ci>d_L_infinity</ci>
                  </apply>
               </apply>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Em_L</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="L_type_Em_conduit_d_gate">
      <variable initial_value="0.002572773" name="d_L" public_interface="out" units="dimensionless"/>
      <variable name="d_L_infinity" public_interface="out" units="dimensionless"/>
      <variable name="alpha_d_L" units="per_second"/>
      <variable name="beta_d_L" units="per_second"/>
      <variable name="tau_d_L" units="second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_d_L</ci>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <apply>
                     <times/>
                     <apply>
                        <minus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt_second">28.39</cn>
                     </apply>
                     <apply>
                        <plus/>
                        <ci>V</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">35</cn>
                     </apply>
                  </apply>
                  <apply>
                     <minus/>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">35</cn>
                           </apply>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">2.5</cn>
                           </apply>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  </apply>
               </apply>
               <apply>
                  <divide/>
                  <apply>
                     <times/>
                     <apply>
                        <minus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt_second">84.9</cn>
                     </apply>
                     <ci>V</ci>
                  </apply>
                  <apply>
                     <minus/>
                     <apply>
                        <exp/>
                        <apply>
                           <times/>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.208</cn>
                           </apply>
                           <ci>V</ci>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_d_L</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt_second">11.43</cn>
                  <apply>
                     <minus/>
                     <ci>V</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">5</cn>
                  </apply>
               </apply>
               <apply>
                  <minus/>
                  <apply>
                     <exp/>
                     <apply>
                        <times/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.4</cn>
