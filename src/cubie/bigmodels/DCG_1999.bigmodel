         <apply>
            <eq/>
            <ci>phi_TAbC</ci>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millimolar_second">129000</cn>
                  <ci>Em_i</ci>
