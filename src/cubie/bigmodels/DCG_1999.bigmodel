               <apply>
                  <plus/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">5.1</cn>
                        </apply>
                        <apply>
                           <minus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">7.4</cn>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>tau_P_a</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <plus/>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">17</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <times/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.0398</cn>
                           <ci>V</ci>
                        </apply>
                     </apply>
                  </apply>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">2.11</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <times/>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.051</cn>
                           </apply>
                           <ci>V</ci>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>P_a</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>P_a_infinity</ci>
                  <ci>P_a</ci>
               </apply>
               <ci>tau_P_a</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="delayed_rectifying_azure_flux_P_i_gate">
      <variable initial_value="0.3777728" name="P_i" public_interface="out" units="dimensionless"/>
      <variable name="alpha_P_i" units="per_second"/>
      <variable name="beta_P_i" units="per_second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_P_i</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">100</cn>
               <apply>
                  <exp/>
                  <apply>
                     <times/>
                     <apply>
                        <minus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.0183</cn>
                     </apply>
                     <ci>V</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_P_i</ci>
