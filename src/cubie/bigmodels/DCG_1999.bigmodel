   <component name="delayed_rectifying_azure_flux">
      <variable name="i_Az" public_interface="out" units="nanoA"/>
      <variable name="g_Az" units="microS"/>
      <variable name="F_cwave_Az" units="dimensionless"/>
      <variable name="cwave" public_interface="in" units="millimolar"/>
      <variable name="E_Az" public_interface="in" units="millivolt"/>
      <variable name="time" private_interface="out" public_interface="in" units="second"/>
      <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
      <variable name="Az_b" public_interface="in" units="millimolar"/>
      <variable name="P_a" private_interface="in" units="dimensionless"/>
      <variable name="P_i" private_interface="in" units="dimensionless"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>F_cwave_Az</ci>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.62</cn>
                  <apply>
                     <plus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <apply>
                        <divide/>
                        <apply>
                           <times/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2.6129</cn>
                           <ci>cwave</ci>
                        </apply>
                        <apply>
                           <plus/>
                           <ci>cwave</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">9<sep/>-3</cn>
                        </apply>
                     </apply>
                  </apply>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.025</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>g_Az</ci>
            <apply>
               <times/>
               <ci>F_cwave_Az</ci>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="microS">0.00693</cn>
               <apply>
                  <power/>
                  <apply>
                     <divide/>
                     <ci>Az_b</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar">1</cn>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.59</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_Az</ci>
            <apply>
               <times/>
               <ci>g_Az</ci>
               <ci>P_a</ci>
               <ci>P_i</ci>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Az</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="delayed_rectifying_azure_flux_P_a_gate">
      <variable initial_value="0.02302278" name="P_a" public_interface="out" units="dimensionless"/>
