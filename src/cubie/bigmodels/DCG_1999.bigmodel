      <variable name="i_B_Cr" public_interface="out" units="nanoA"/>
      <variable name="i_B_Em" public_interface="out" units="nanoA"/>
      <variable name="i_B_Az" public_interface="out" units="nanoA"/>
      <variable initial_value="0.00016" name="g_B_Cr" units="microS"/>
      <variable initial_value="0.0000364" name="g_B_Em" units="microS"/>
      <variable initial_value="0.0000694" name="g_B_Az" units="microS"/>
      <variable name="E_Cr" public_interface="in" units="millivolt"/>
      <variable name="E_Em" public_interface="in" units="millivolt"/>
      <variable name="E_Az" public_interface="in" units="millivolt"/>
      <variable name="F_brakes_bCr" units="dimensionless"/>
      <variable name="brakes" public_interface="in" units="millimolar"/>
      <variable name="time" public_interface="in" units="second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>F_brakes_bCr</ci>
            <apply>
               <minus/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <divide/>
                  <ci>brakes</ci>
                  <apply>
                     <plus/>
                     <ci>brakes</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">5<sep/>-1</cn>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_B_Cr</ci>
            <apply>
               <times/>
               <ci>F_brakes_bCr</ci>
               <ci>g_B_Cr</ci>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Cr</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_B_Em</ci>
            <apply>
               <times/>
               <ci>g_B_Em</ci>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Em</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_B_Az</ci>
            <apply>
               <times/>
               <ci>g_B_Az</ci>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Az</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_B</ci>
            <apply>
               <plus/>
               <ci>i_B_Cr</ci>
               <ci>i_B_Em</ci>
               <ci>i_B_Az</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="underswing_activated_flux">
      <variable name="i_f" public_interface="out" units="nanoA"/>
      <variable name="i_f_Cr" public_interface="out" units="nanoA"/>
      <variable name="i_f_Az" public_interface="out" units="nanoA"/>
      <variable initial_value="0.0067478" name="g_f_Cr" units="microS"/>
      <variable initial_value="0.0128821" name="g_f_Az" units="microS"/>
      <variable name="time" private_interface="out" public_interface="in" units="second"/>
      <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
      <variable name="cwave" private_interface="out" public_interface="in" units="millimolar"/>
      <variable name="y" private_interface="in" units="dimensionless"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_f_Cr</ci>
            <apply>
               <times/>
               <ci>g_f_Cr</ci>
               <apply>
                  <power/>
                  <ci>y</ci>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
               </apply>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">75</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_f_Az</ci>
            <apply>
               <times/>
               <ci>g_f_Az</ci>
               <apply>
                  <power/>
                  <ci>y</ci>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
               </apply>
               <apply>
                  <plus/>
                  <ci>V</ci>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">85</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_f</ci>
            <apply>
               <plus/>
               <ci>i_f_Cr</ci>
               <ci>i_f_Az</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="underswing_activated_flux_y_gate">
      <variable initial_value="0.09227776" name="y" public_interface="out" units="dimensionless"/>
      <variable name="y_infinity" units="dimensionless"/>
      <variable name="V_half" units="millivolt"/>
      <variable name="cwave" public_interface="in" units="millimolar"/>
      <variable name="tau_y" units="second"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>V_half</ci>
            <apply>
               <minus/>
               <apply>
                  <divide/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">20.5</cn>
                  <apply>
                     <plus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <minus/>
                              <ci>cwave</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">3.4<sep/>-3</cn>
                           </apply>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">5<sep/>-4</cn>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">78.56</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>y_infinity</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <plus/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <minus/>
                           <ci>V</ci>
                           <ci>V_half</ci>
                        </apply>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">9</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>tau_y</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="second">1</cn>
               <apply>
                  <plus/>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.6483</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">54.06</cn>
                           </apply>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">24.33</cn>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
                  <apply>
                     <divide/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">14.01055</cn>
                     <apply>
                        <plus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.7</cn>
                        <apply>
                           <exp/>
                           <apply>
                              <divide/>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">60</cn>
                              </apply>
                              <apply>
                                 <minus/>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">5.5</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>y</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>y_infinity</ci>
                  <ci>y</ci>
               </apply>
               <ci>tau_y</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_azure_pump">
      <variable name="i_CrAz" public_interface="out" units="nanoA"/>
      <variable initial_value="5.46" name="Az_m_Cr" units="millimolar"/>
      <variable initial_value="0.621" name="Az_m_Az" units="millimolar"/>
      <variable initial_value="0.2192" name="i_CrAz_max" units="nanoA"/>
      <variable name="F_cwave_CrAz" units="dimensionless"/>
      <variable name="cwave" public_interface="in" units="millimolar"/>
      <variable name="Cr_i" public_interface="in" units="millimolar"/>
      <variable name="Az_c" public_interface="in" units="millimolar"/>
      <variable name="Em_i" public_interface="in" units="millimolar"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>F_cwave_CrAz</ci>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.6</cn>
                  <apply>
                     <plus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <apply>
                        <exp/>
                        <apply>
                           <divide/>
                           <apply>
                              <minus/>
                              <ci>cwave</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">3.75<sep/>-3</cn>
                           </apply>
                           <apply>
                              <minus/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" type="e-notation" bigmodel:units="millimolar">1.5<sep/>-4</cn>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.99</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_CrAz</ci>
            <piecewise>
               <piece>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <apply>
                           <minus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                           <ci>F_cwave_CrAz</ci>
                        </apply>
                        <ci>i_CrAz_max</ci>
                        <apply>
                           <power/>
                           <apply>
                              <divide/>
                              <ci>Cr_i</ci>
                              <apply>
                                 <plus/>
                                 <ci>Az_m_Cr</ci>
                                 <ci>Cr_i</ci>
                              </apply>
                           </apply>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        </apply>
                        <apply>
                           <power/>
                           <apply>
                              <divide/>
                              <ci>Az_c</ci>
                              <apply>
                                 <plus/>
                                 <ci>Az_m_Az</ci>
                                 <ci>Az_c</ci>
                              </apply>
                           </apply>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                        </apply>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.6</cn>
                     </apply>
                     <apply>
                        <plus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.5</cn>
                        <apply>
                           <exp/>
                           <apply>
                              <divide/>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">60</cn>
                              </apply>
                              <apply>
                                 <minus/>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">40</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
                  <apply>
                     <lt/>
                     <ci>Em_i</ci>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar">0.00015</cn>
                  </apply>
               </piece>
               <otherwise>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <ci>F_cwave_CrAz</ci>
                        <ci>i_CrAz_max</ci>
                        <apply>
                           <power/>
                           <apply>
                              <divide/>
                              <ci>Cr_i</ci>
                              <apply>
                                 <plus/>
                                 <ci>Az_m_Cr</ci>
                                 <ci>Cr_i</ci>
                              </apply>
                           </apply>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        </apply>
                        <apply>
                           <power/>
                           <apply>
                              <divide/>
                              <ci>Az_c</ci>
                              <apply>
                                 <plus/>
                                 <ci>Az_m_Az</ci>
                                 <ci>Az_c</ci>
                              </apply>
                           </apply>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                        </apply>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.6</cn>
                     </apply>
                     <apply>
                        <plus/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.5</cn>
                        <apply>
                           <exp/>
                           <apply>
                              <divide/>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">60</cn>
                              </apply>
                              <apply>
                                 <minus/>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">40</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </otherwise>
            </piecewise>
         </apply>
      </math>
   </component>
   <component name="emerald_pump_flux">
      <variable name="i_Em_P" public_interface="out" units="nanoA"/>
      <variable initial_value="0.02869" name="i_Em_P_max" units="nanoA"/>
      <variable name="Em_i" public_interface="in" units="millimolar"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_Em_P</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <ci>i_Em_P_max</ci>
                  <ci>Em_i</ci>
               </apply>
               <apply>
                  <plus/>
                  <ci>Em_i</ci>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar">0.0004</cn>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_emerald_pump">
      <variable name="i_CrEm" public_interface="out" units="nanoA"/>
      <variable initial_value="0.00001248" name="Az_CrEm" units="nanoA"/>
      <variable initial_value="0.0001" name="d_CrEm" units="dimensionless"/>
      <variable initial_value="0.5" name="gamma" units="dimensionless"/>
      <variable name="Cr_i" public_interface="in" units="millimolar"/>
      <variable name="Cr_c" public_interface="in" units="millimolar"/>
      <variable name="Em_i" public_interface="in" units="millimolar"/>
      <variable name="Em_c" public_interface="in" units="millimolar"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_CrEm</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <ci>Az_CrEm</ci>
                  <apply>
                     <minus/>
                     <apply>
                        <times/>
                        <apply>
                           <power/>
                           <ci>Cr_i</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        </apply>
                        <ci>Em_c</ci>
                        <apply>
                           <exp/>
                           <apply>
                              <times/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.03743</cn>
                              <ci>V</ci>
                              <ci>gamma</ci>
                           </apply>
                        </apply>
                     </apply>
                     <apply>
                        <times/>
                        <apply>
                           <power/>
                           <ci>Cr_c</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        </apply>
                        <ci>Em_i</ci>
                        <apply>
                           <exp/>
                           <apply>
                              <times/>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.03743</cn>
                              <ci>V</ci>
                              <apply>
                                 <minus/>
                                 <ci>gamma</ci>
                                 <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
               <apply>
                  <plus/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar_4">1</cn>
                  <apply>
                     <times/>
                     <ci>d_CrEm</ci>
                     <apply>
                        <plus/>
                        <apply>
                           <times/>
                           <ci>Em_i</ci>
                           <apply>
                              <power/>
                              <ci>Cr_c</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                           </apply>
                        </apply>
                        <apply>
                           <times/>
                           <ci>Em_c</ci>
                           <apply>
                              <power/>
                              <ci>Cr_i</ci>
                              <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="damped_azure_flux">
      <variable name="i_Az_brakes" public_interface="out" units="nanoA"/>
      <variable name="I_Az_brakes" units="nanoA"/>
      <variable name="brakes" public_interface="in" units="millimolar"/>
      <variable name="g_Az_brakes" units="microS"/>
      <variable initial_value="7.833e-3" name="g_Az_brakes_base" units="microS"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="E_Az" public_interface="in" units="millivolt"/>
      <variable name="P_M2_Azbrakes" units="dimensionless"/>
      <variable initial_value="0" name="a" units="dimensionless"/>
      <variable name="alpha_a" units="per_second"/>
      <variable name="beta_a" units="per_second"/>
      <variable name="f_Idle" public_interface="in" units="per_second"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_Az_brakes</ci>
            <apply>
               <times/>
               <ci>a</ci>
               <ci>I_Az_brakes</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>a</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <ci>beta_a</ci>
                  <apply>
                     <minus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <ci>a</ci>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <ci>alpha_a</ci>
                  <ci>a</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_a</ci>
            <apply>
               <divide/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">12.32</cn>
               <apply>
                  <plus/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <divide/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar">0.0042</cn>
                     <ci>brakes</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>alpha_a</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">17</cn>
               <apply>
                  <exp/>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.0133</cn>
                     <apply>
                        <plus/>
                        <ci>V</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">40</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>I_Az_brakes</ci>
            <apply>
               <times/>
               <ci>g_Az_brakes</ci>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Az</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>g_Az_brakes</ci>
            <apply>
               <times/>
               <ci>P_M2_Azbrakes</ci>
               <ci>g_Az_brakes_base</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>P_M2_Azbrakes</ci>
            <piecewise>
               <piece>
                  <apply>
                     <minus/>
                     <apply>
                        <divide/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1.026</cn>
                        <apply>
                           <plus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                           <apply>
                              <exp/>
                              <apply>
                                 <divide/>
                                 <apply>
                                    <plus/>
                                    <ci>f_Idle</ci>
                                    <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">11.05</cn>
                                 </apply>
                                 <apply>
                                    <minus/>
                                    <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">7.5095</cn>
                                 </apply>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.99</cn>
                  </apply>
                  <apply>
                     <and/>
                     <apply>
                        <lt/>
                        <ci>f_Idle</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">100</cn>
                     </apply>
                     <apply>
                        <gt/>
                        <ci>f_Idle</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">25</cn>
                     </apply>
                  </apply>
               </piece>
               <otherwise>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.0006</cn>
               </otherwise>
            </piecewise>
         </apply>
      </math>
   </component>
   <component name="inner_concentrations_and_buffer_equations">
