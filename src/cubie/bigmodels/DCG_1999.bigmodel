   <component name="gap_space_equations">
      <variable initial_value="139.9988" name="Cr_c" public_interface="out" units="millimolar"/>
      <variable initial_value="2.00474" name="Em_c" public_interface="out" units="millimolar"/>
      <variable initial_value="5.389014" name="Az_c" public_interface="out" units="millimolar"/>
      <variable initial_value="5.4" name="Az_b" public_interface="out" units="millimolar"/>
      <variable initial_value="140" name="Cr_b" units="millimolar"/>
      <variable initial_value="2" name="Em_b" units="millimolar"/>
      <variable initial_value="3.497e-6" name="Vol" public_interface="out" units="mm_cubed"/>
      <variable name="V_c" units="mm_cubed"/>
      <variable initial_value="0.01" name="tau_p" units="second"/>
      <variable name="i_CrAz" public_interface="in" units="nanoA"/>
      <variable name="i_CrEm" public_interface="in" units="nanoA"/>
      <variable name="i_B_Cr" public_interface="in" units="nanoA"/>
      <variable name="i_f_Cr" public_interface="in" units="nanoA"/>
      <variable name="i_Cr" public_interface="in" units="nanoA"/>
      <variable name="i_Az" public_interface="in" units="nanoA"/>
      <variable name="i_B_Az" public_interface="in" units="nanoA"/>
      <variable name="i_f_Az" public_interface="in" units="nanoA"/>
      <variable name="i_Em_L" public_interface="in" units="nanoA"/>
      <variable name="i_Em_T" public_interface="in" units="nanoA"/>
      <variable name="i_Em_P" public_interface="in" units="nanoA"/>
      <variable name="i_B_Em" public_interface="in" units="nanoA"/>
      <variable name="F" public_interface="in" units="coulomb_per_mole"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>V_c</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.136</cn>
               <ci>Vol</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Cr_c</ci>
            </apply>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <apply>
                     <minus/>
                     <ci>Cr_b</ci>
                     <ci>Cr_c</ci>
                  </apply>
                  <ci>tau_p</ci>
               </apply>
               <apply>
                  <divide/>
                  <apply>
                     <plus/>
                     <ci>i_Cr</ci>
                     <apply>
                        <times/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        <ci>i_CrEm</ci>
                     </apply>
                     <apply>
                        <times/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        <ci>i_CrAz</ci>
                     </apply>
                     <ci>i_B_Cr</ci>
                     <ci>i_f_Cr</ci>
                  </apply>
                  <apply>
                     <times/>
                     <ci>F</ci>
                     <ci>V_c</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Az_c</ci>
            </apply>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <apply>
                     <minus/>
                     <ci>Az_b</ci>
                     <ci>Az_c</ci>
                  </apply>
                  <ci>tau_p</ci>
               </apply>
               <apply>
                  <divide/>
                  <apply>
                     <plus/>
                     <apply>
                        <times/>
                        <apply>
                           <minus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                        </apply>
                        <ci>i_CrAz</ci>
                     </apply>
                     <ci>i_Az</ci>
                     <ci>i_B_Az</ci>
                     <ci>i_f_Az</ci>
                  </apply>
                  <apply>
                     <times/>
                     <ci>F</ci>
                     <ci>V_c</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Em_c</ci>
            </apply>
            <apply>
               <plus/>
               <apply>
                  <divide/>
                  <apply>
                     <minus/>
                     <ci>Em_b</ci>
                     <ci>Em_c</ci>
                  </apply>
                  <ci>tau_p</ci>
               </apply>
               <apply>
                  <divide/>
                  <apply>
                     <plus/>
                     <apply>
                        <times/>
                        <apply>
                           <minus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                        </apply>
                        <ci>i_CrEm</ci>
                     </apply>
                     <ci>i_Em_L</ci>
                     <ci>i_Em_T</ci>
                     <ci>i_Em_P</ci>
                     <ci>i_B_Em</ci>
                  </apply>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                     <ci>F</ci>
                     <ci>V_c</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="tank_Em_uptake_and_release">
      <variable name="i_rel" public_interface="out" units="nanoA"/>
      <variable name="i_up" public_interface="out" units="nanoA"/>
      <variable initial_value="16.95311" name="Em_up" units="millimolar"/>
      <variable initial_value="0.08" name="alpha_up" units="nanoA"/>
      <variable initial_value="0.072" name="beta_up" units="nanoA"/>
      <variable initial_value="16.85024" name="Em_rel" units="millimolar"/>
      <variable initial_value="0.5" name="alpha_rel" units="nanoA_per_millimolar"/>
      <variable name="i_tr" units="nanoA"/>
      <variable name="Az1" units="dimensionless"/>
      <variable name="Az2" units="millimolar"/>
      <variable initial_value="0.00005" name="k_cyca" units="millimolar"/>
      <variable initial_value="0.9" name="k_xcs" units="dimensionless"/>
      <variable initial_value="22" name="k_tankEm" units="millimolar"/>
      <variable initial_value="0.004" name="k_rel" units="millimolar"/>
      <variable name="r_act" units="per_second"/>
      <variable name="r_inact" units="per_second"/>
      <variable initial_value="0.9528726" name="Em_Store" units="dimensionless"/>
      <variable name="phi_Store" units="per_second"/>
      <variable initial_value="0.1133251" name="F1" units="dimensionless"/>
      <variable initial_value="0.0007594214" name="F2" units="dimensionless"/>
      <variable initial_value="0.8859153" name="F3" units="dimensionless"/>
      <variable name="V_i" public_interface="in" units="mm_cubed"/>
      <variable name="V_up" units="mm_cubed"/>
      <variable name="V_rel" units="mm_cubed"/>
      <variable name="Em_i" public_interface="in" units="millimolar"/>
      <variable name="F" public_interface="in" units="coulomb_per_mole"/>
      <variable name="V" public_interface="in" units="millivolt"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>V_up</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.01166</cn>
               <ci>V_i</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>V_rel</ci>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.001296</cn>
               <ci>V_i</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>Az1</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <ci>k_cyca</ci>
                  <ci>k_xcs</ci>
               </apply>
               <ci>k_tankEm</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>Az2</ci>
            <apply>
               <plus/>
               <ci>Em_i</ci>
               <apply>
                  <times/>
                  <ci>Em_up</ci>
                  <ci>Az1</ci>
               </apply>
               <apply>
                  <times/>
                  <ci>k_cyca</ci>
                  <ci>k_xcs</ci>
               </apply>
               <ci>k_cyca</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>r_act</ci>
            <apply>
               <plus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">240</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <times/>
                        <apply>
                           <minus/>
                           <ci>V</ci>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millivolt">40</cn>
                        </apply>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millivolt">0.08</cn>
                     </apply>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">240</cn>
                  <apply>
                     <power/>
                     <apply>
                        <divide/>
                        <ci>Em_i</ci>
                        <apply>
                           <plus/>
                           <ci>Em_i</ci>
                           <ci>k_rel</ci>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">4</cn>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>r_inact</ci>
            <apply>
               <plus/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">40</cn>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">240</cn>
                  <apply>
                     <power/>
                     <apply>
                        <divide/>
                        <ci>Em_i</ci>
                        <apply>
                           <plus/>
                           <ci>Em_i</ci>
                           <ci>k_rel</ci>
                        </apply>
                     </apply>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">4</cn>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>phi_Store</ci>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_millimolar_second">770</cn>
                  <ci>Em_rel</ci>
                  <apply>
                     <minus/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                     <ci>Em_Store</ci>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">641</cn>
                  <ci>Em_Store</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Em_Store</ci>
            </apply>
            <ci>phi_Store</ci>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>F1</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">0.96</cn>
                  <ci>F3</ci>
               </apply>
               <apply>
                  <times/>
                  <ci>r_act</ci>
                  <ci>F1</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>F2</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <ci>r_act</ci>
                  <ci>F1</ci>
               </apply>
               <apply>
                  <times/>
                  <ci>r_inact</ci>
                  <ci>F2</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>F3</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <ci>r_inact</ci>
                  <ci>F2</ci>
               </apply>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="per_second">0.96</cn>
                  <ci>F3</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_rel</ci>
            <apply>
               <times/>
               <ci>alpha_rel</ci>
               <apply>
                  <power/>
                  <apply>
                     <divide/>
                     <ci>F2</ci>
                     <apply>
                        <plus/>
                        <ci>F2</ci>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.25</cn>
                     </apply>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
               </apply>
               <ci>Em_rel</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_tr</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <apply>
                     <minus/>
                     <ci>Em_up</ci>
                     <ci>Em_rel</ci>
                  </apply>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                  <ci>F</ci>
                  <ci>V_up</ci>
               </apply>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="second">0.06418</cn>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>i_up</ci>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <apply>
                     <times/>
                     <ci>alpha_up</ci>
                     <ci>Em_i</ci>
                  </apply>
                  <apply>
                     <times/>
                     <ci>beta_up</ci>
                     <ci>Em_up</ci>
                     <ci>Az1</ci>
                  </apply>
               </apply>
               <ci>Az2</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Em_up</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <ci>i_up</ci>
                  <ci>i_tr</ci>
               </apply>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                  <ci>V_up</ci>
                  <ci>F</ci>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Em_rel</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <divide/>
                  <apply>
                     <minus/>
                     <ci>i_tr</ci>
                     <ci>i_rel</ci>
                  </apply>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">2</cn>
                     <ci>V_rel</ci>
                     <ci>F</ci>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="millimolar">11.48</cn>
                  <ci>phi_Store</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="reversal_potentials">
      <variable name="E_Cr" public_interface="out" units="millivolt"/>
      <variable name="E_Az" public_interface="out" units="millivolt"/>
      <variable name="E_Em" public_interface="out" units="millivolt"/>
      <variable name="Az_c" public_interface="in" units="millimolar"/>
      <variable name="Cr_c" public_interface="in" units="millimolar"/>
      <variable name="Az_i" public_interface="in" units="millimolar"/>
      <variable name="Cr_i" public_interface="in" units="millimolar"/>
      <variable name="Em_c" public_interface="in" units="millimolar"/>
      <variable name="Em_i" public_interface="in" units="millimolar"/>
      <variable name="R" public_interface="in" units="joule_per_kilomole_kelvin"/>
      <variable name="T" public_interface="in" units="kelvin"/>
      <variable name="F" public_interface="in" units="coulomb_per_mole"/>
      <variable name="time" public_interface="in" units="second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>E_Cr</ci>
            <apply>
               <times/>
               <apply>
                  <divide/>
                  <apply>
                     <times/>
                     <ci>R</ci>
                     <ci>T</ci>
                  </apply>
                  <ci>F</ci>
               </apply>
               <apply>
                  <ln/>
                  <apply>
                     <divide/>
                     <ci>Cr_c</ci>
                     <ci>Cr_i</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>E_Az</ci>
            <apply>
               <times/>
               <apply>
                  <divide/>
                  <apply>
                     <times/>
                     <ci>R</ci>
                     <ci>T</ci>
                  </apply>
                  <ci>F</ci>
               </apply>
               <apply>
                  <ln/>
                  <apply>
                     <divide/>
                     <ci>Az_c</ci>
                     <ci>Az_i</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>E_Em</ci>
            <apply>
               <times/>
               <apply>
                  <divide/>
                  <apply>
                     <times/>
                     <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">0.5</cn>
                     <ci>R</ci>
                     <ci>T</ci>
                  </apply>
                  <ci>F</ci>
               </apply>
               <apply>
                  <ln/>
                  <apply>
                     <divide/>
                     <ci>Em_c</ci>
                     <ci>Em_i</ci>
                  </apply>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="cwave_balance">
      <variable initial_value="3e-3" name="cwave" public_interface="out" units="millimolar"/>
      <variable initial_value="2e-3" name="gwave" units="millimolar"/>
      <variable initial_value="0" name="gas" units="millimolar"/>
      <variable initial_value="0" name="brakes" public_interface="out" units="millimolar"/>
      <variable initial_value="0.14e-3" name="Azm_gas" units="millimolar"/>
      <variable initial_value="0.14e-3" name="Azm_brakes" units="millimolar"/>
      <variable initial_value="6" name="Az_PDE" units="dimensionless"/>
      <variable initial_value="8e-3" name="Az_ADC" units="millimolar_per_second"/>
      <variable initial_value="20" name="V_PDE" units="per_second"/>
      <variable initial_value="0.02" name="P_M2_ADC" units="dimensionless"/>
      <variable name="time" public_interface="in" units="second"/>
      <variable initial_value="200" name="f_Idle" public_interface="out" units="per_second"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>cwave</ci>
            </apply>
            <apply>
               <times/>
               <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
               <apply>
                  <minus/>
                  <apply>
                     <times/>
                     <ci>Az_ADC</ci>
                     <apply>
                        <minus/>
                        <apply>
                           <plus/>
                           <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">1</cn>
                           <apply>
                              <divide/>
                              <ci>gas</ci>
                              <apply>
                                 <plus/>
                                 <ci>gas</ci>
                                 <ci>Azm_gas</ci>
                              </apply>
                           </apply>
                        </apply>
                        <apply>
                           <divide/>
                           <apply>
                              <times/>
                              <ci>P_M2_ADC</ci>
                              <ci>brakes</ci>
                           </apply>
                           <apply>
                              <plus/>
                              <apply>
                                 <times/>
                                 <ci>P_M2_ADC</ci>
                                 <ci>brakes</ci>
                              </apply>
                              <ci>Azm_brakes</ci>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <ci>V_PDE</ci>
                        <ci>gwave</ci>
                        <ci>cwave</ci>
                     </apply>
                     <apply>
                        <plus/>
                        <ci>cwave</ci>
                        <apply>
                           <times/>
                           <ci>Az_PDE</ci>
                           <ci>gwave</ci>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
