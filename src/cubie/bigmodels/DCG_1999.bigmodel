               <ci>phi_TAbC</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>phi_B</ci>
            <apply>
               <plus/>
               <ci>F_C</ci>
               <ci>F_TC</ci>
               <ci>F_TAbC</ci>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>Cr_i</ci>
            </apply>
            <apply>
               <divide/>
               <apply>
                  <minus/>
                  <apply>
                     <plus/>
                     <apply>
                        <times/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        <ci>i_CrAz</ci>
                     </apply>
                     <apply>
                        <times/>
                        <cn xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" bigmodel:units="dimensionless">3</cn>
                        <ci>i_CrEm</ci>
                     </apply>
                     <ci>i_B_Cr</ci>
                     <ci>i_f_Cr</ci>
                     <ci>i_Cr</ci>
                  </apply>
