<?xml version='1.0' encoding='UTF-8'?>
<model name="FL" xmlns="http://www.bigmodel.org/bigmodel/1.0#" xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" xmlns:cmeta="http://www.bigmodel.org/metadata/1.0#">
    <units name="per_second">
        <unit exponent="-1" units="second"/>
    </units>
    <units name="millisecond">
        <unit prefix="milli" units="second"/>
    </units>
    <units name="per_millisecond">
        <unit exponent="-1" units="millisecond"/>
    </units>
    <units name="minute">
        <unit multiplier="60" units="second"/>
    </units>
    <units name="per_minute">
        <unit exponent="-1" multiplier="60" units="second"/>
    </units>
    <units name="millivolt">
        <unit prefix="milli" units="volt"/>
    </units>
    <units name="per_millivolt">
        <unit exponent="-1" prefix="milli" units="volt"/>
    </units>
    <units name="per_millivolt_second">
        <unit exponent="-1" units="millivolt"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="millivolt_second">
        <unit units="millivolt"/>
        <unit units="second"/>
    </units>
    <units name="microS">
        <unit prefix="micro" units="siemens"/>
    </units>
    <units name="microF">
        <unit prefix="micro" units="farad"/>
    </units>
    <units name="nanoA">
        <unit prefix="nano" units="ampere"/>
    </units>
    <units name="mA_nA">
        <unit prefix="milli" units="ampere"/>
        <unit exponent="-1" units="nanoA"/>
    </units>
    <units name="millimolar">
        <unit prefix="milli" units="mole"/>
        <unit exponent="-1" units="litre"/>
    </units>
    <units name="nanomolar">
        <unit prefix="nano" units="mole"/>
        <unit exponent="-1" units="litre"/>
    </units>
    <units name="per_nanomolar">
        <unit exponent="-1" units="nanomolar"/>
    </units>
    <units name="per_millimolar">
        <unit exponent="-1" units="millimolar"/>
    </units>
    <units name="millimolar4">
        <unit exponent="4" units="millimolar"/>
    </units>
    <units name="millimolar_per_second">
        <unit units="millimolar"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_millimolar2_second">
        <unit exponent="-2" units="millimolar"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_millimolar_second">
        <unit exponent="-1" units="millimolar"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_millimolar_minute">
        <unit exponent="-1" units="millimolar"/>
        <unit exponent="-1" multiplier="60" units="second"/>
    </units>
    <units name="nanoA_per_millimolar">
        <unit units="nanoA"/>
        <unit exponent="-1" units="millimolar"/>
    </units>
    <units name="joule_per_kilomole_kelvin">
        <unit units="joule"/>
        <unit exponent="-1" prefix="kilo" units="mole"/>
        <unit exponent="-1" units="kelvin"/>
    </units>
    <units name="coulomb_per_mole">
        <unit units="coulomb"/>
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="millimetre">
        <unit prefix="milli" units="metre"/>
    </units>
    <units name="micrometre">
        <unit prefix="micro" units="metre"/>
    </units>
    <units name="millimetre3">
        <unit exponent="3" prefix="milli" units="metre"/>
    </units>
    <units name="litre_millimetre3">
        <unit units="litre"/>
        <unit exponent="-1" units="millimetre3"/>
    </units>
    <units name="micrometre_per_femtometre">
        <unit units="micrometre"/>
        <unit exponent="-1" prefix="femto" units="metre"/>
    </units>
    <units name="nanoS">
        <unit prefix="nano" units="siemens"/>
    </units>
    <component name="environment">
        <variable name="time" public_interface="out" units="second"/>
    </component>
    <component name="Outerboundary">
        <variable initial_value="8314.472" name="R" public_interface="out" units="joule_per_kilomole_kelvin"/>
        <variable initial_value="310" name="T" public_interface="out" units="kelvin"/>
        <variable initial_value="96485.3415" name="F" public_interface="out" units="coulomb_per_mole"/>
        <variable initial_value="5.7e-5" name="C" units="microF"/>
        <variable name="RTONF" public_interface="out" units="millivolt"/>
        <variable name="time" private_interface="out" public_interface="in" units="second"/>
        <variable name="i_f" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_CrAz" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_CrEm" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_Cr" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_Azr" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_Azs" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_to" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_EmL" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_EmT" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_Azbrakes" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="i_Azur" private_interface="out" public_interface="in" units="nanoA"/>
        <variable name="V" public_interface="out" units="millivolt"/>
        <variable initial_value="0" name="clamp_mode" units="dimensionless"/>
        <variable name="V_clamp" private_interface="in" units="millivolt"/>
        <variable initial_value="-47.787168" name="V_ode" units="millivolt"/>
        <variable name="i_tot" units="nanoA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_tot</ci>
                <apply>
                    <plus/>
                    <ci>i_f</ci>
                    <ci>i_Azr</ci>
                    <ci>i_Azs</ci>
                    <ci>i_to</ci>
                    <ci>i_CrAz</ci>
                    <ci>i_CrEm</ci>
                    <ci>i_Cr</ci>
                    <ci>i_EmL</ci>
                    <ci>i_EmT</ci>
                    <ci>i_Azbrakes</ci>
                    <ci>i_Azur</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>V_ode</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>i_tot</ci>
                    </apply>
                    <ci>C</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RTONF</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>R</ci>
                        <ci>T</ci>
                    </apply>
                    <ci>F</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V</ci>
                <piecewise>
                    <piece>
                        <ci>V_clamp</ci>
                        <apply>
                            <geq/>
                            <ci>clamp_mode</ci>
                            <cn bigmodel:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>V_ode</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <component name="Voltage_clamp">
        <variable initial_value="0.5" name="t_holding" units="second"/>
        <variable initial_value="0.5" name="t_test" units="second"/>
        <variable name="V_clamp" public_interface="out" units="millivolt"/>
        <variable initial_value="-35" name="V_test" units="millivolt"/>
        <variable initial_value="-45" name="V_holding" units="millivolt"/>
        <variable name="time" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>V_clamp</ci>
                <piecewise>
                    <piece>
                        <ci>V_test</ci>
                        <apply>
                            <and/>
                            <apply>
                                <gt/>
                                <ci>time</ci>
                                <ci>t_holding</ci>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>t_holding</ci>
                                    <ci>t_test</ci>
                                </apply>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>V_holding</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <component name="Rate_modulation_experiments">
        <variable initial_value="0" name="brakes" public_interface="out" units="nanomolar"/>
        <variable initial_value="0" name="gas_1_uM" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="TRIM" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="gas_cas" public_interface="out" units="nanomolar"/>
        <variable initial_value="0" name="brakes_cas" public_interface="out" units="nanomolar"/>
    </component>
    <component name="Charge_values">
        <variable name="Cri" public_interface="in" units="millimolar"/>
        <variable initial_value="140" name="Cro" public_interface="out" units="millimolar"/>
        <variable initial_value="140" name="Azi" public_interface="out" units="millimolar"/>
        <variable initial_value="5.4" name="Azo" public_interface="out" units="millimolar"/>
        <variable name="Em_sub" public_interface="in" units="millimolar"/>
        <variable initial_value="1.8" name="Emo" public_interface="out" units="millimolar"/>
        <variable name="RTONF" public_interface="in" units="millivolt"/>
        <variable name="E_Cr" public_interface="out" units="millivolt"/>
        <variable name="E_Az" public_interface="out" units="millivolt"/>
        <variable name="E_Em" public_interface="out" units="millivolt"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>E_Cr</ci>
                <apply>
                    <times/>
                    <ci>RTONF</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Cro</ci>
                            <ci>Cri</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Az</ci>
                <apply>
                    <times/>
                    <ci>RTONF</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Azo</ci>
                            <ci>Azi</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Em</ci>
                <apply>
                    <times/>
                    <cn bigmodel:units="dimensionless">0.5</cn>
                    <ci>RTONF</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Emo</ci>
                            <ci>Em_sub</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Cri_concentration">
        <variable name="Cri" public_interface="out" units="millimolar"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="F" public_interface="in" units="coulomb_per_mole"/>
        <variable name="V_sub" public_interface="in" units="millimetre3"/>
        <variable name="V_i" public_interface="in" units="millimetre3"/>
        <variable name="i_Cr" public_interface="in" units="nanoA"/>
        <variable name="i_CrEm" public_interface="in" units="nanoA"/>
        <variable name="i_CrAz" public_interface="in" units="nanoA"/>
        <variable name="i_fCr" public_interface="in" units="nanoA"/>
        <variable name="i_siCr" public_interface="in" units="nanoA"/>
        <variable initial_value="5" name="Cri_" units="millimolar"/>
        <variable initial_value="1" name="Cri_clamp" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Cri_</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>Cri_clamp</ci>
                        </apply>
                        <apply>
                            <minus/>
                            <cn bigmodel:units="mA_nA">1</cn>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>i_Cr</ci>
                            <ci>i_fCr</ci>
                            <ci>i_siCr</ci>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">3</cn>
                                <ci>i_CrAz</ci>
                            </apply>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">3</cn>
                                <ci>i_CrEm</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn bigmodel:units="litre_millimetre3">1</cn>
                        <apply>
                            <plus/>
                            <ci>V_i</ci>
                            <ci>V_sub</ci>
                        </apply>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Cri</ci>
                <ci>Cri_</ci>
            </apply>
        </math>
    </component>
    <component name="i_f">
        <variable name="brakes" private_interface="out" public_interface="in" units="nanomolar"/>
        <variable name="gas_1_uM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="TRIM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="cwave" private_interface="out" public_interface="in" units="millimolar"/>
        <variable name="i_f" public_interface="out" units="nanoA"/>
        <variable name="i_fCr" public_interface="out" units="nanoA"/>
        <variable name="E_Cr" public_interface="in" units="millivolt"/>
        <variable name="E_Az" public_interface="in" units="millivolt"/>
        <variable name="i_fAz" public_interface="out" units="nanoA"/>
        <variable initial_value="0.00427" name="g_f" units="microS"/>
        <variable name="G_f" units="microS"/>
        <variable name="g_f_Cr" public_interface="out" units="microS"/>
        <variable name="G_f_Cr" units="microS"/>
        <variable name="g_f_Az" public_interface="out" units="microS"/>
        <variable name="G_f_Az" units="microS"/>
        <variable initial_value="45" name="Azm_f" units="millimolar"/>
        <variable initial_value="0.5927" name="alpha" units="dimensionless"/>
        <variable name="time" private_interface="out" public_interface="in" units="second"/>
        <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
        <variable name="RTONF" public_interface="in" units="millivolt"/>
        <variable name="Azo" public_interface="in" units="millimolar"/>
        <variable name="y" private_interface="in" units="dimensionless"/>
        <variable initial_value="0" name="blockade" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>G_f</ci>
                <apply>
                    <divide/>
                    <ci>g_f</ci>
                    <apply>
                        <divide/>
                        <ci>Azo</ci>
                        <apply>
                            <plus/>
                            <ci>Azo</ci>
                            <ci>Azm_f</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>G_f_Az</ci>
                <apply>
                    <divide/>
                    <ci>G_f</ci>
                    <apply>
                        <plus/>
                        <ci>alpha</ci>
                        <cn bigmodel:units="dimensionless">1</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>G_f_Cr</ci>
                <apply>
                    <times/>
                    <ci>alpha</ci>
                    <ci>G_f_Az</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>g_f_Cr</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>G_f_Cr</ci>
                        <ci>Azo</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>Azo</ci>
                        <ci>Azm_f</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>g_f_Az</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>G_f_Az</ci>
                        <ci>Azo</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>Azo</ci>
                        <ci>Azm_f</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_fCr</ci>
                <apply>
                    <times/>
                    <ci>y</ci>
                    <ci>g_f_Cr</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_Cr</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <ci>blockade</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_fAz</ci>
                <apply>
                    <times/>
                    <ci>y</ci>
                    <ci>g_f_Az</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_Az</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <ci>blockade</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_f</ci>
                <apply>
                    <plus/>
                    <ci>i_fCr</ci>
                    <ci>i_fAz</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_f_y_gate">
        <variable initial_value="0.009508" name="y" public_interface="out" units="dimensionless"/>
        <variable name="tau_y" units="second"/>
        <variable name="y_infinity" units="dimensionless"/>
        <variable name="V" public_interface="in" units="millivolt"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="brakes_shift" units="millivolt"/>
        <variable name="brakes" public_interface="in" units="nanomolar"/>
        <variable name="gas_1_uM" public_interface="in" units="dimensionless"/>
        <variable name="gas_shift" units="millivolt"/>
        <variable initial_value="0" name="y_shift" units="millivolt"/>
        <variable name="TRIM" public_interface="in" units="dimensionless"/>
        <variable name="TRIM_shift_i_f_y_gate" units="millivolt"/>
        <variable name="cwave" public_interface="in" units="millimolar"/>
        <variable initial_value="26.26" name="Azi_f" units="millivolt"/>
        <variable initial_value="9.281" name="ni_f" units="dimensionless"/>
        <variable initial_value="0.02979017" name="Az_05i_f" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>brakes_shift</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <minus/>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="millivolt">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="millivolt">9.898</cn>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <times/>
                                            <cn bigmodel:units="per_nanomolar" type="e-notation">1<sep/>-6</cn>
                                            <ci>brakes</ci>
                                        </apply>
                                        <cn bigmodel:units="dimensionless">0.618</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <times/>
                                            <cn bigmodel:units="per_nanomolar" type="e-notation">1<sep/>-6</cn>
                                            <ci>brakes</ci>
                                        </apply>
                                        <cn bigmodel:units="dimensionless">0.618</cn>
                                    </apply>
                                    <cn bigmodel:units="dimensionless">0.00122423</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>brakes</ci>
                            <cn bigmodel:units="nanomolar">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="millivolt">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>gas_shift</ci>
                <piecewise>
                    <piece>
                        <cn bigmodel:units="millivolt">7.5</cn>
                        <apply>
                            <gt/>
                            <ci>gas_1_uM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="millivolt">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>TRIM_shift_i_f_y_gate</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <minus/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>Azi_f</ci>
                                    <apply>
                                        <power/>
                                        <ci>cwave</ci>
                                        <ci>ni_f</ci>
                                    </apply>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <power/>
                                        <ci>Az_05i_f</ci>
                                        <ci>ni_f</ci>
                                    </apply>
                                    <apply>
                                        <power/>
                                        <ci>cwave</ci>
                                        <ci>ni_f</ci>
                                    </apply>
                                </apply>
                            </apply>
                            <cn bigmodel:units="millivolt">18.76</cn>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="millivolt">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>tau_y</ci>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="per_millivolt_second">0.36</cn>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <minus/>
                                            <apply>
                                                <minus/>
                                                <apply>
                                                    <plus/>
                                                    <ci>V</ci>
                                                    <cn bigmodel:units="millivolt">148.8</cn>
                                                </apply>
                                                <ci>brakes_shift</ci>
                                            </apply>
                                            <ci>gas_shift</ci>
                                        </apply>
                                        <ci>TRIM_shift_i_f_y_gate</ci>
                                    </apply>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <exp/>
                                        <apply>
                                            <times/>
                                            <cn bigmodel:units="per_millivolt">0.066</cn>
                                            <apply>
                                                <minus/>
                                                <apply>
                                                    <minus/>
                                                    <apply>
                                                        <minus/>
                                                        <apply>
                                                            <plus/>
                                                            <ci>V</ci>
