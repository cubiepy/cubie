        <variable name="time" private_interface="out" public_interface="in" units="second"/>
        <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
        <variable initial_value="0.4578" name="P_EmL" units="nanoA_per_millimolar"/>
        <variable name="RTONF" public_interface="in" units="millivolt"/>
        <variable name="Cro" public_interface="in" units="millimolar"/>
        <variable name="Cri" public_interface="in" units="millimolar"/>
        <variable name="Azo" public_interface="in" units="millimolar"/>
        <variable name="Azi" public_interface="in" units="millimolar"/>
        <variable name="Emo" public_interface="in" units="millimolar"/>
        <variable name="Em_sub" private_interface="out" public_interface="in" units="millimolar"/>
        <variable name="dL" private_interface="in" units="dimensionless"/>
        <variable name="fL" private_interface="in" units="dimensionless"/>
        <variable name="fEm" private_interface="in" units="dimensionless"/>
        <variable name="gas_increase" units="dimensionless"/>
        <variable name="gas_1_uM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="TRIM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="TRIM_cond_i_EmL" units="dimensionless"/>
        <variable name="cog" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable initial_value="0.470657" name="Az_i_EmL1" units="dimensionless"/>
        <variable initial_value="0.730287" name="Az_05i_EmL1" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>gas_increase</ci>
                <piecewise>
                    <piece>
                        <cn bigmodel:units="dimensionless">1.23</cn>
                        <apply>
                            <gt/>
                            <ci>gas_1_uM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="dimensionless">1</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>TRIM_cond_i_EmL</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">0.2152</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>Az_i_EmL1</ci>
                                    <apply>
                                        <power/>
                                        <ci>cog</ci>
                                        <cn bigmodel:units="dimensionless">10.0808</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <power/>
                                        <ci>Az_05i_EmL1</ci>
                                        <cn bigmodel:units="dimensionless">10.0808</cn>
                                    </apply>
                                    <apply>
                                        <power/>
                                        <ci>cog</ci>
                                        <cn bigmodel:units="dimensionless">10.0808</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>i_siEm</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn bigmodel:units="dimensionless">2</cn>
                            <ci>P_EmL</ci>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>brakes_block</ci>
                            </apply>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>gas_increase</ci>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>TRIM_cond_i_EmL</ci>
                            </apply>
                            <apply>
                                <minus/>
                                <ci>V</ci>
                                <cn bigmodel:units="millivolt">0</cn>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>RTONF</ci>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <cn bigmodel:units="dimensionless">1</cn>
                                            </apply>
                                            <apply>
                                                <minus/>
                                                <ci>V</ci>
                                                <cn bigmodel:units="millivolt">0</cn>
                                            </apply>
                                            <cn bigmodel:units="dimensionless">2</cn>
                                        </apply>
                                        <ci>RTONF</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Em_sub</ci>
                        <apply>
                            <times/>
                            <ci>Emo</ci>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <cn bigmodel:units="dimensionless">2</cn>
                                        </apply>
                                        <apply>
