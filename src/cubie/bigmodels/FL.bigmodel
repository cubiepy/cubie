                    <ci>fL</ci>
                    <ci>fEm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_siAz</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn bigmodel:units="dimensionless">0.000365</cn>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>brakes_block</ci>
                            </apply>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>gas_increase</ci>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>TRIM_cond_i_EmL</ci>
                            </apply>
                            <ci>P_EmL</ci>
                            <apply>
                                <minus/>
                                <ci>V</ci>
                                <cn bigmodel:units="millivolt">0</cn>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>RTONF</ci>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <cn bigmodel:units="dimensionless">1</cn>
                                            </apply>
                                            <apply>
                                                <minus/>
                                                <ci>V</ci>
                                                <cn bigmodel:units="millivolt">0</cn>
                                            </apply>
                                        </apply>
                                        <ci>RTONF</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Azi</ci>
                        <apply>
                            <times/>
                            <ci>Azo</ci>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <cn bigmodel:units="dimensionless">1</cn>
                                        </apply>
                                        <apply>
                                            <minus/>
                                            <ci>V</ci>
                                            <cn bigmodel:units="millivolt">0</cn>
                                        </apply>
                                    </apply>
                                    <ci>RTONF</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <ci>dL</ci>
                    <ci>fL</ci>
                    <ci>fEm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_siCr</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn bigmodel:units="dimensionless">0.0000185</cn>
                            <ci>P_EmL</ci>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>brakes_block</ci>
                            </apply>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>gas_increase</ci>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <ci>TRIM_cond_i_EmL</ci>
                            </apply>
                            <apply>
                                <minus/>
                                <ci>V</ci>
                                <cn bigmodel:units="millivolt">0</cn>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>RTONF</ci>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <cn bigmodel:units="dimensionless">1</cn>
                                            </apply>
                                            <apply>
                                                <minus/>
                                                <ci>V</ci>
                                                <cn bigmodel:units="millivolt">0</cn>
                                            </apply>
                                        </apply>
                                        <ci>RTONF</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Cri</ci>
                        <apply>
                            <times/>
                            <ci>Cro</ci>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <cn bigmodel:units="dimensionless">1</cn>
                                        </apply>
                                        <apply>
                                            <minus/>
                                            <ci>V</ci>
                                            <cn bigmodel:units="millivolt">0</cn>
                                        </apply>
                                    </apply>
                                    <ci>RTONF</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <ci>dL</ci>
                    <ci>fL</ci>
                    <ci>fEm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>brakes_block</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn bigmodel:units="dimensionless">0.31</cn>
                        <cn bigmodel:units="dimensionless" type="e-notation">1<sep/>-6</cn>
                        <ci>brakes</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>brakes</ci>
                        <cn bigmodel:units="nanomolar">0.00009</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_EmL</ci>
                <apply>
                    <plus/>
                    <ci>i_siEm</ci>
                    <ci>i_siAz</ci>
                    <ci>i_siCr</ci>
