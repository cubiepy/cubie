                            </apply>
                            <cn bigmodel:units="dimensionless">25.87</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn bigmodel:units="dimensionless">0.45260509</cn>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <ci>cwave</ci>
                                        </apply>
                                        <cn bigmodel:units="dimensionless">600</cn>
                                        <cn bigmodel:units="dimensionless">0.03395094</cn>
                                    </apply>
                                </apply>
                            </apply>
                            <cn bigmodel:units="dimensionless">0.99221714</cn>
