                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>beta_n</ci>
                <apply>
                    <times/>
                    <cn bigmodel:units="per_second">1</cn>
                    <apply>
                        <exp/>
                        <apply>
                            <divide/>
                            <apply>
                                <minus/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <minus/>
                                            <ci>V</ci>
                                            <ci>gas_shift</ci>
                                        </apply>
                                        <ci>TRIM_shift_i_Azs_n_gate</ci>
                                    </apply>
                                    <cn bigmodel:units="millivolt">5</cn>
                                </apply>
                            </apply>
                            <cn bigmodel:units="millivolt">25</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>n</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>n_infinity</ci>
                        <ci>n</ci>
                    </apply>
                    <ci>tau_n</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_Azbrakes">
        <variable name="TRIM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="brakes" private_interface="out" public_interface="in" units="nanomolar"/>
        <variable name="brakes_cas" private_interface="out" public_interface="in" units="nanomolar"/>
        <variable name="i_Azbrakes" public_interface="out" units="nanoA"/>
        <variable initial_value="0.00345" name="g_Azbrakes" units="microS"/>
        <variable initial_value="1.29637" name="Az_g_brakes_max" units="dimensionless"/>
        <variable name="E_Az" public_interface="in" units="millivolt"/>
        <variable name="time" private_interface="out" public_interface="in" units="second"/>
        <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
        <variable name="a" private_interface="in" units="dimensionless"/>
        <variable initial_value="1" name="brakes_on" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_Azbrakes</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>Az_g_brakes_max</ci>
                            <ci>g_Azbrakes</ci>
                            <apply>
                                <minus/>
                                <ci>V</ci>
                                <ci>E_Az</ci>
                            </apply>
                            <ci>a</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <gt/>
                                <ci>TRIM</ci>
                                <cn bigmodel:units="dimensionless">0</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>brakes_cas</ci>
                                <cn bigmodel:units="nanomolar">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <times/>
                            <ci>brakes_on</ci>
                            <ci>g_Azbrakes</ci>
                            <apply>
                                <minus/>
                                <ci>V</ci>
                                <ci>E_Az</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <ci>V</ci>
                                            <cn bigmodel:units="millivolt">20</cn>
                                        </apply>
                                        <cn bigmodel:units="millivolt">20</cn>
                                    </apply>
                                </apply>
                            </apply>
                            <ci>a</ci>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>brakes</ci>
                            <cn bigmodel:units="nanomolar">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="nanoA">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <component name="i_Azbrakes_a_gate">
        <variable initial_value="0.00277" name="a" public_interface="out" units="dimensionless"/>
        <variable name="alpha_a" units="per_second"/>
        <variable name="beta_a" units="per_second"/>
        <variable name="a_infinity" units="dimensionless"/>
        <variable name="tau_a" units="second"/>
        <variable name="TRIM" public_interface="in" units="dimensionless"/>
        <variable name="brakes" public_interface="in" units="nanomolar"/>
        <variable name="brakes_cas" public_interface="in" units="nanomolar"/>
        <variable initial_value="1.19683" name="Az_alpha" units="dimensionless"/>
        <variable initial_value="139.301" name="Az_alpha_add" units="dimensionless"/>
        <variable initial_value="0.00568561" name="Az_alpha_div" units="dimensionless"/>
        <variable initial_value="16.2494" name="Az_beta" units="dimensionless"/>
        <variable name="V" public_interface="in" units="millivolt"/>
        <variable name="time" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha_a</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>Az_alpha</ci>
                                <cn bigmodel:units="dimensionless">0.001</cn>
                                <cn bigmodel:units="per_second">12.32</cn>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>Az_alpha_add</ci>
                                <apply>
                                    <divide/>
                                    <ci>Az_alpha_div</ci>
                                    <apply>
                                        <times/>
                                        <ci>brakes_cas</ci>
                                        <cn bigmodel:units="per_nanomolar" type="e-notation">1<sep/>-6</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <plus/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <cn bigmodel:units="per_second">3.5988</cn>
                                    <cn bigmodel:units="per_second">0.025641</cn>
                                </apply>
                                <apply>
                                    <plus/>
                                    <cn bigmodel:units="dimensionless">1</cn>
                                    <apply>
                                        <divide/>
                                        <cn bigmodel:units="dimensionless">0.0000012155</cn>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn bigmodel:units="per_nanomolar" type="e-notation">1<sep/>-6</cn>
                                                <ci>brakes</ci>
                                            </apply>
                                            <cn bigmodel:units="dimensionless">1.6951</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                            <cn bigmodel:units="per_second">0.025641</cn>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta_a</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <cn bigmodel:units="per_second">0.001</cn>
                            <ci>Az_beta</ci>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="per_millivolt">0.0133</cn>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <cn bigmodel:units="millivolt">40</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <cn bigmodel:units="per_second">10</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="per_millivolt">0.0133</cn>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <cn bigmodel:units="millivolt">40</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>a_infinity</ci>
                <apply>
                    <divide/>
                    <ci>alpha_a</ci>
                    <apply>
                        <plus/>
                        <ci>alpha_a</ci>
                        <ci>beta_a</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_a</ci>
                <apply>
                    <divide/>
                    <cn bigmodel:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <ci>alpha_a</ci>
                        <ci>beta_a</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>a</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>a_infinity</ci>
                        <ci>a</ci>
                    </apply>
                    <ci>tau_a</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="cwave">
        <variable initial_value="0.032883333" name="cwave" public_interface="out" units="millimolar"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="diff_cwave" units="millimolar_per_second"/>
        <variable name="gas_cas" public_interface="in" units="nanomolar"/>
        <variable name="brakes_cas" public_interface="in" units="nanomolar"/>
        <variable name="fueli" public_interface="in" units="millimolar"/>
        <variable name="kgas" units="per_millisecond"/>
        <variable initial_value="0.007" name="Az_gas" units="dimensionless"/>
        <variable initial_value="58.57114132" name="Az_05gas" units="nanomolar"/>
        <variable initial_value="0.9264" name="ngas" units="dimensionless"/>
        <variable name="kbrakes" units="per_minute"/>
        <variable initial_value="1.37475" name="Az_brakes" units="dimensionless"/>
        <variable initial_value="43.4557" name="Az_05brakes" units="nanomolar"/>
        <variable initial_value="0.948264" name="nbrakes" units="dimensionless"/>
        <variable name="k1" units="per_minute"/>
        <variable name="kb_CM" public_interface="in" units="per_second"/>
        <variable name="fCMi" public_interface="in" units="dimensionless"/>
        <variable name="kf_CM" public_interface="in" units="per_millimolar_second"/>
        <variable initial_value="4.64625" name="Az_k1" units="dimensionless"/>
        <variable initial_value="0.016" name="Az_ACI" units="per_minute"/>
        <variable initial_value="0.0735" name="Az_AC" units="per_minute"/>
        <variable initial_value="0.000563995" name="Az_Em" units="millimolar"/>
        <variable initial_value="0.000024" name="Az_ACEm" units="millimolar"/>
        <variable name="k2" units="per_minute"/>
        <variable name="k3" units="per_minute"/>
        <variable initial_value="15" name="kcog" units="per_minute"/>
        <variable initial_value="5" name="ncog" units="dimensionless"/>
        <variable initial_value="0.47416667" name="kcog_cwave" units="millimolar"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>cwave</ci>
                </apply>
                <ci>diff_cwave</ci>
            </apply>
            <apply>
                <eq/>
                <ci>diff_cwave</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <minus/>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <ci>kgas</ci>
                                        <ci>kbrakes</ci>
                                    </apply>
                                    <ci>fueli</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>k1</ci>
                                    <ci>fueli</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>k2</ci>
                                <ci>cwave</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k3</ci>
                            <ci>cwave</ci>
                        </apply>
                    </apply>
                    <cn bigmodel:units="dimensionless">60</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>kgas</ci>
                <apply>
                    <plus/>
                    <ci>Az_gas</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn bigmodel:units="dimensionless">0.1181</cn>
                            <apply>
                                <power/>
                                <ci>gas_cas</ci>
                                <ci>ngas</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>Az_05gas</ci>
                                <ci>ngas</ci>
                            </apply>
                            <apply>
                                <power/>
                                <ci>gas_cas</ci>
                                <ci>ngas</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>kbrakes</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>Az_brakes</ci>
                        <cn bigmodel:units="dimensionless">0.0146</cn>
                        <apply>
                            <power/>
                            <ci>brakes_cas</ci>
                            <ci>nbrakes</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>Az_05brakes</ci>
                            <ci>nbrakes</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>brakes_cas</ci>
                            <ci>nbrakes</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k1</ci>
                <apply>
                    <times/>
                    <ci>Az_k1</ci>
                    <apply>
                        <plus/>
                        <ci>Az_ACI</ci>
                        <apply>
                            <divide/>
                            <ci>Az_AC</ci>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <minus/>
                                            <ci>Az_Em</ci>
                                            <apply>
                                                <divide/>
                                                <apply>
                                                    <times/>
                                                    <ci>kb_CM</ci>
                                                    <ci>fCMi</ci>
                                                </apply>
                                                <apply>
                                                    <times/>
                                                    <ci>kf_CM</ci>
                                                    <apply>
                                                        <minus/>
                                                        <cn bigmodel:units="dimensionless">1</cn>
                                                        <ci>fCMi</ci>
                                                    </apply>
                                                </apply>
                                            </apply>
                                        </apply>
                                        <ci>Az_ACEm</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn bigmodel:units="dimensionless">1.1</cn>
                        <cn bigmodel:units="dimensionless">237.9851</cn>
                        <apply>
                            <power/>
                            <apply>
                                <times/>
                                <ci>cwave</ci>
                                <cn bigmodel:units="dimensionless">600</cn>
                            </apply>
                            <cn bigmodel:units="dimensionless">5.101</cn>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <cn bigmodel:units="dimensionless">20.1077</cn>
                            <cn bigmodel:units="dimensionless">6.101</cn>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <times/>
                                <ci>cwave</ci>
                                <cn bigmodel:units="dimensionless">600</cn>
                            </apply>
                            <cn bigmodel:units="dimensionless">6.101</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k3</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>kcog</ci>
                        <apply>
                            <power/>
                            <ci>cwave</ci>
                            <apply>
                                <minus/>
                                <ci>ncog</ci>
                                <cn bigmodel:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>kcog_cwave</ci>
                            <ci>ncog</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>cwave</ci>
                            <ci>ncog</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="rodp">
        <variable initial_value="0.23" name="rodp" public_interface="out" units="dimensionless"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="diff_rodp" units="per_second"/>
        <variable name="k4" units="per_minute"/>
        <variable name="cog" public_interface="in" units="dimensionless"/>
        <variable initial_value="52.25" name="krodp" units="per_minute"/>
        <variable initial_value="1" name="nrod" units="dimensionless"/>
        <variable initial_value="1.610336" name="kcog_rod" units="dimensionless"/>
        <variable name="k5" units="per_minute"/>
        <variable initial_value="23575" name="kpin" units="per_millimolar_minute"/>
        <variable initial_value="0.00089" name="pin" units="millimolar"/>
        <variable initial_value="0.07457" name="kpin_rod" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>rodp</ci>
                </apply>
                <ci>diff_rodp</ci>
            </apply>
            <apply>
                <eq/>
                <ci>diff_rodp</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>k4</ci>
                        <ci>k5</ci>
                    </apply>
                    <cn bigmodel:units="dimensionless">60</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k4</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>krodp</ci>
                        <apply>
                            <power/>
                            <ci>cog</ci>
                            <ci>nrod</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>kcog_rod</ci>
                            <ci>nrod</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>cog</ci>
                            <ci>nrod</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k5</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>kpin</ci>
                        <ci>pin</ci>
                        <ci>rodp</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>kpin_rod</ci>
                        <ci>rodp</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="cog">
        <variable name="cog" public_interface="out" units="dimensionless"/>
