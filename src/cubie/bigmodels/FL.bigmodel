                                            <cn bigmodel:units="millivolt">75</cn>
                                        </apply>
                                        <cn bigmodel:units="millivolt">15.38</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <ci>offset_fT</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>fT</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>fT_infinity</ci>
                        <ci>fT</ci>
                    </apply>
                    <ci>tau_fT</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Em_tank_release">
        <variable name="j_tankEmrel" public_interface="out" units="millimolar_per_second"/>
        <variable initial_value="0.9308" name="R" units="dimensionless"/>
        <variable initial_value="6.181512e-9" name="O" units="dimensionless"/>
        <variable initial_value="4.595622e-10" name="I" units="dimensionless"/>
        <variable initial_value="0.069199" name="RI" units="dimensionless"/>
        <variable initial_value="148041085.1" name="ks" units="per_second"/>
        <variable initial_value="15" name="Maxtank" units="dimensionless"/>
        <variable initial_value="1" name="Mintank" units="dimensionless"/>
        <variable initial_value="0.45" name="EC50_tank" units="millimolar"/>
        <variable initial_value="2.5" name="Htank" units="dimensionless"/>
        <variable name="kotankEm" units="per_millimolar2_second"/>
        <variable name="kitankEm" units="per_millimolar_second"/>
        <variable initial_value="10000" name="koEm_max" units="per_millimolar2_second"/>
        <variable name="koEm" units="per_millimolar2_second"/>
        <variable initial_value="500" name="kiEm" units="per_millimolar_second"/>
        <variable name="kEmtank" units="dimensionless"/>
        <variable initial_value="5" name="kim" units="per_second"/>
        <variable initial_value="660" name="kom" units="per_second"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="Em_sub" public_interface="in" units="millimolar"/>
        <variable name="Em_jtank" public_interface="in" units="millimolar"/>
        <variable name="diff" units="millimolar"/>
        <variable name="P_tot" units="dimensionless"/>
        <variable name="TRIM" private_interface="out" public_interface="in" units="dimensionless"/>
        <variable name="cog" public_interface="in" units="dimensionless"/>
        <variable initial_value="0.0127" name="valve_min" units="dimensionless"/>
        <variable initial_value="0.02" name="valve_max" units="dimensionless"/>
        <variable initial_value="0.682891" name="Az_05valve" units="dimensionless"/>
        <variable initial_value="9.773" name="nvalve" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>koEm</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>koEm_max</ci>
                            <apply>
                                <plus/>
                                <apply>
                                    <minus/>
                                    <ci>valve_min</ci>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>valve_max</ci>
                                            <apply>
                                                <power/>
                                                <ci>cog</ci>
                                                <ci>nvalve</ci>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <plus/>
                                            <apply>
                                                <power/>
                                                <ci>Az_05valve</ci>
                                                <ci>nvalve</ci>
                                            </apply>
                                            <apply>
                                                <power/>
                                                <ci>cog</ci>
                                                <ci>nvalve</ci>
                                            </apply>
                                        </apply>
                                    </apply>
                                </apply>
                                <cn bigmodel:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="dimensionless">10000</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>j_tankEmrel</ci>
                <apply>
                    <times/>
                    <ci>ks</ci>
                    <ci>O</ci>
                    <apply>
                        <minus/>
                        <ci>Em_jtank</ci>
                        <ci>Em_sub</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>diff</ci>
                <apply>
                    <minus/>
                    <ci>Em_jtank</ci>
                    <ci>Em_sub</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>kEmtank</ci>
                <apply>
                    <minus/>
                    <ci>Maxtank</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>Maxtank</ci>
                            <ci>Mintank</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>EC50_tank</ci>
                                    <ci>Em_jtank</ci>
                                </apply>
                                <ci>Htank</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>kotankEm</ci>
                <apply>
                    <divide/>
                    <ci>koEm</ci>
                    <ci>kEmtank</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>kitankEm</ci>
                <apply>
                    <times/>
                    <ci>kiEm</ci>
                    <ci>kEmtank</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>R</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kim</ci>
                            <ci>RI</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kitankEm</ci>
                            <ci>Em_sub</ci>
                            <ci>R</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kotankEm</ci>
                            <apply>
                                <power/>
                                <ci>Em_sub</ci>
                                <cn bigmodel:units="dimensionless">2</cn>
                            </apply>
                            <ci>R</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kom</ci>
                            <ci>O</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>O</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kotankEm</ci>
                            <apply>
                                <power/>
                                <ci>Em_sub</ci>
                                <cn bigmodel:units="dimensionless">2</cn>
                            </apply>
                            <ci>R</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kom</ci>
                            <ci>O</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kitankEm</ci>
                            <ci>Em_sub</ci>
                            <ci>O</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kim</ci>
                            <ci>I</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>I</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kitankEm</ci>
                            <ci>Em_sub</ci>
                            <ci>O</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kim</ci>
                            <ci>I</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kom</ci>
                            <ci>I</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kotankEm</ci>
                            <apply>
                                <power/>
                                <ci>Em_sub</ci>
                                <cn bigmodel:units="dimensionless">2</cn>
                            </apply>
                            <ci>RI</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>RI</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kom</ci>
                            <ci>I</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kotankEm</ci>
                            <apply>
                                <power/>
                                <ci>Em_sub</ci>
                                <cn bigmodel:units="dimensionless">2</cn>
                            </apply>
                            <ci>RI</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kim</ci>
                            <ci>RI</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>kitankEm</ci>
                            <ci>Em_sub</ci>
                            <ci>R</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_tot</ci>
                <apply>
                    <plus/>
                    <ci>R</ci>
                    <ci>O</ci>
                    <ci>I</ci>
                    <ci>RI</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Em_inner_fluxes">
        <variable name="j_Em_dif" public_interface="out" units="millimolar_per_second"/>
        <variable name="j_up" public_interface="out" units="millimolar_per_second"/>
        <variable name="j_tr" public_interface="out" units="millimolar_per_second"/>
        <variable initial_value="5.469e-5" name="tau_dif_Em" units="second"/>
        <variable initial_value="0.04" name="tau_tr" units="second"/>
        <variable name="P_up" units="millimolar_per_second"/>
        <variable initial_value="5" name="P_up_basal" units="millimolar_per_second"/>
        <variable name="b_up" units="dimensionless"/>
        <variable name="brakes" public_interface="in" units="nanomolar"/>
        <variable name="gas_1_uM" public_interface="in" units="dimensionless"/>
        <variable initial_value="0.000286113" name="Az_up" units="millimolar"/>
        <variable name="Em_ntank" public_interface="in" units="millimolar"/>
        <variable name="Emi" public_interface="in" units="millimolar"/>
        <variable name="Em_sub" public_interface="in" units="millimolar"/>
        <variable name="Em_jtank" public_interface="in" units="millimolar"/>
        <variable initial_value="5e-5" name="slope_up" units="millimolar"/>
        <variable name="TRIM" public_interface="in" units="dimensionless"/>
        <variable name="rodp" public_interface="in" units="dimensionless"/>
        <variable name="F_rodp" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>b_up</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <minus/>
                            <cn bigmodel:units="dimensionless">0.25</cn>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>gas_1_uM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">0.7</cn>
                                <cn bigmodel:units="dimensionless" type="e-notation">1<sep/>-6</cn>
                                <ci>brakes</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="dimensionless" type="e-notation">1<sep/>-6</cn>
                                    <ci>brakes</ci>
                                </apply>
                                <cn bigmodel:units="nanomolar">0.00009</cn>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>brakes</ci>
                            <cn bigmodel:units="nanomolar">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn bigmodel:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>P_up</ci>
                <apply>
                    <times/>
                    <ci>P_up_basal</ci>
                    <apply>
                        <minus/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <ci>b_up</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_Em_dif</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>Em_sub</ci>
                        <ci>Emi</ci>
                    </apply>
                    <ci>tau_dif_Em</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_tr</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>Em_ntank</ci>
                        <ci>Em_jtank</ci>
                    </apply>
                    <ci>tau_tr</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>F_rodp</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">3.3931</cn>
                                <apply>
                                    <power/>
                                    <ci>rodp</ci>
                                    <cn bigmodel:units="dimensionless">4.0695</cn>
                                </apply>
                            </apply>
                            <apply>
                                <plus/>
                                <apply>
                                    <power/>
                                    <cn bigmodel:units="dimensionless">0.2805</cn>
                                    <cn bigmodel:units="dimensionless">4.0695</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>rodp</ci>
                                    <cn bigmodel:units="dimensionless">4.0695</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>rodp</ci>
                            <cn bigmodel:units="dimensionless">0.23</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">1.698</cn>
                                <apply>
                                    <power/>
                                    <ci>rodp</ci>
                                    <cn bigmodel:units="dimensionless">13.5842</cn>
                                </apply>
                            </apply>
                            <apply>
                                <plus/>
                                <apply>
                                    <power/>
                                    <cn bigmodel:units="dimensionless">0.2240</cn>
                                    <cn bigmodel:units="dimensionless">13.5842</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>rodp</ci>
                                    <cn bigmodel:units="dimensionless">13.5842</cn>
                                </apply>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>j_up</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">0.9</cn>
                                <ci>P_up</ci>
                                <ci>F_rodp</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <apply>
                                                <minus/>
                                                <ci>Emi</ci>
                                            </apply>
                                            <ci>Az_up</ci>
                                        </apply>
                                        <ci>slope_up</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <gt/>
                            <ci>TRIM</ci>
                            <cn bigmodel:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <divide/>
                            <ci>P_up</ci>
                            <apply>
                                <plus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <apply>
                                                <minus/>
                                                <ci>Emi</ci>
                                            </apply>
                                            <ci>Az_up</ci>
                                        </apply>
                                        <ci>slope_up</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <component name="Em_buffering">
        <variable initial_value="0.031" name="TC_tot" public_interface="out" units="millimolar"/>
        <variable initial_value="0.062" name="TMC_tot" public_interface="out" units="millimolar"/>
        <variable initial_value="0.045" name="CM_tot" public_interface="out" units="millimolar"/>
