                    <ci>fCMs</ci>
                </apply>
                <ci>delta_fCMs</ci>
            </apply>
            <apply>
                <eq/>
                <ci>delta_fCMs</ci>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>kf_CM</ci>
                        <ci>Em_sub</ci>
                        <apply>
                            <minus/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>fCMs</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>kb_CM</ci>
                        <ci>fCMs</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>fCQ</ci>
                </apply>
                <ci>delta_fCQ</ci>
            </apply>
            <apply>
                <eq/>
                <ci>delta_fCQ</ci>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>kf_CQ</ci>
                        <ci>Em_jtank</ci>
                        <apply>
                            <minus/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <ci>fCQ</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>kb_CQ</ci>
                        <ci>fCQ</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Em_dynamics">
        <variable initial_value="9.15641e-6" name="Emi" public_interface="out" units="millimolar"/>
        <variable initial_value="0.435148" name="Em_ntank" public_interface="out" units="millimolar"/>
        <variable initial_value="0.409551" name="Em_jtank" public_interface="out" units="millimolar"/>
        <variable initial_value="6.226104e-5" name="Em_sub" public_interface="out" units="millimolar"/>
        <variable name="V_i" public_interface="in" units="millimetre3"/>
        <variable name="V_jtank" public_interface="in" units="millimetre3"/>
        <variable name="V_ntank" public_interface="in" units="millimetre3"/>
        <variable name="V_sub" public_interface="in" units="millimetre3"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="F" public_interface="in" units="coulomb_per_mole"/>
        <variable name="i_siEm" public_interface="in" units="nanoA"/>
        <variable name="i_EmT" public_interface="in" units="nanoA"/>
        <variable name="i_CrEm" public_interface="in" units="nanoA"/>
        <variable name="j_tankEmrel" public_interface="in" units="millimolar_per_second"/>
        <variable name="j_Em_dif" public_interface="in" units="millimolar_per_second"/>
        <variable name="j_tr" public_interface="in" units="millimolar_per_second"/>
        <variable name="j_up" public_interface="in" units="millimolar_per_second"/>
        <variable name="TMC_tot" public_interface="in" units="millimolar"/>
        <variable name="CM_tot" public_interface="in" units="millimolar"/>
        <variable name="TC_tot" public_interface="in" units="millimolar"/>
        <variable name="CQ_tot" public_interface="in" units="millimolar"/>
        <variable name="delta_fTMC" public_interface="in" units="per_second"/>
        <variable name="delta_fCMi" public_interface="in" units="per_second"/>
        <variable name="delta_fCMs" public_interface="in" units="per_second"/>
        <variable name="delta_fTC" public_interface="in" units="per_second"/>
        <variable name="delta_fCQ" public_interface="in" units="per_second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Emi</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <apply>
                                <minus/>
                                <apply>
                                    <times/>
                                    <ci>j_Em_dif</ci>
                                    <ci>V_sub</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>j_up</ci>
                                    <ci>V_ntank</ci>
                                </apply>
                            </apply>
                        </apply>
                        <ci>V_i</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>CM_tot</ci>
                            <ci>delta_fCMi</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>TC_tot</ci>
                            <ci>delta_fTC</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>TMC_tot</ci>
                            <ci>delta_fTMC</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Em_sub</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>j_tankEmrel</ci>
                            <ci>V_jtank</ci>
                        </apply>
                        <ci>V_sub</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <ci>i_siEm</ci>
                                    <ci>i_EmT</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="dimensionless">2</cn>
                                    <ci>i_CrEm</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <cn bigmodel:units="dimensionless">2</cn>
                                <ci>F</ci>
                                <ci>V_sub</ci>
                            </apply>
                        </apply>
                        <ci>j_Em_dif</ci>
                        <apply>
                            <times/>
                            <ci>CM_tot</ci>
                            <ci>delta_fCMs</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Em_ntank</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>j_up</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>j_tr</ci>
                            <ci>V_jtank</ci>
                        </apply>
                        <ci>V_ntank</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Em_jtank</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>j_tr</ci>
                    <apply>
                        <plus/>
                        <ci>j_tankEmrel</ci>
                        <apply>
                            <times/>
                            <ci>CQ_tot</ci>
                            <ci>delta_fCQ</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Vessel_parameters">
        <variable name="V_sub" public_interface="out" units="millimetre3"/>
        <variable name="V_jtank" public_interface="out" units="millimetre3"/>
        <variable name="V_ntank" public_interface="out" units="millimetre3"/>
        <variable name="V_i" public_interface="out" units="millimetre3"/>
        <variable name="V_vessel" units="millimetre3"/>
        <variable initial_value="0.0012" name="V_jtank_part" units="dimensionless"/>
        <variable initial_value="0.46" name="V_i_part" units="dimensionless"/>
        <variable initial_value="0.0116" name="V_ntank_part" units="dimensionless"/>
        <variable initial_value="3.9" name="R_vessel" units="micrometre"/>
        <variable initial_value="67" name="L_vessel" units="micrometre"/>
        <variable initial_value="0.02" name="L_sub" units="micrometre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>V_vessel</ci>
                <apply>
                    <times/>
                    <cn bigmodel:units="micrometre_per_femtometre">0.000000001</cn>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>R_vessel</ci>
                        <cn bigmodel:units="dimensionless">2</cn>
                    </apply>
                    <ci>L_vessel</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_sub</ci>
                <apply>
                    <times/>
                    <cn bigmodel:units="micrometre_per_femtometre">0.000000001</cn>
                    <cn bigmodel:units="dimensionless">2</cn>
                    <pi/>
                    <ci>L_sub</ci>
                    <apply>
                        <minus/>
                        <ci>R_vessel</ci>
                        <apply>
                            <divide/>
                            <ci>L_sub</ci>
                            <cn bigmodel:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <ci>L_vessel</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_jtank</ci>
                <apply>
                    <times/>
                    <ci>V_jtank_part</ci>
                    <ci>V_vessel</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_i</ci>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>V_i_part</ci>
                        <ci>V_vessel</ci>
                    </apply>
                    <ci>V_sub</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_ntank</ci>
                <apply>
                    <times/>
                    <ci>V_ntank_part</ci>
                    <ci>V_vessel</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_Azur">
        <variable name="i_Azur" public_interface="out" units="nanoA"/>
        <variable initial_value="0.1539e-3" name="g_Azur" units="microS"/>
        <variable name="time" private_interface="out" public_interface="in" units="second"/>
