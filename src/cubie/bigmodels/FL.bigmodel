                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>Cro</ci>
                            <ci>Az1no</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn bigmodel:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <divide/>
                                    <ci>Cro</ci>
                                    <ci>Az2no</ci>
                                </apply>
                                <apply>
                                    <plus/>
                                    <cn bigmodel:units="dimensionless">1</cn>
                                    <apply>
                                        <divide/>
                                        <ci>Cro</ci>
                                        <ci>Az3no</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_Cr">
        <variable name="i_Cr_" public_interface="out" units="nanoA"/>
        <variable name="i_Cr_L" public_interface="out" units="nanoA"/>
        <variable name="i_Cr" public_interface="out" units="nanoA"/>
        <variable initial_value="0.0223" name="g_Cr" units="microS"/>
        <variable initial_value="0" name="g_Cr_L" units="microS"/>
        <variable name="E_mh" units="millivolt"/>
        <variable name="time" private_interface="out" public_interface="in" units="second"/>
        <variable name="V" private_interface="out" public_interface="in" units="millivolt"/>
        <variable name="RTONF" public_interface="in" units="millivolt"/>
        <variable name="Cro" public_interface="in" units="millimolar"/>
        <variable name="Cri" public_interface="in" units="millimolar"/>
        <variable name="Azo" public_interface="in" units="millimolar"/>
        <variable name="Azi" public_interface="in" units="millimolar"/>
        <variable name="m" private_interface="in" units="dimensionless"/>
        <variable name="h" private_interface="in" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>E_mh</ci>
                <apply>
                    <times/>
                    <ci>RTONF</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <apply>
                                <plus/>
                                <ci>Cro</ci>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="dimensionless">0.12</cn>
                                    <ci>Azo</ci>
                                </apply>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>Cri</ci>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="dimensionless">0.12</cn>
                                    <ci>Azi</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_Cr_</ci>
                <apply>
                    <times/>
                    <ci>g_Cr</ci>
                    <apply>
                        <power/>
                        <ci>m</ci>
                        <cn bigmodel:units="dimensionless">3</cn>
                    </apply>
                    <ci>h</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_mh</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_Cr_L</ci>
                <apply>
                    <times/>
                    <ci>g_Cr_L</ci>
                    <apply>
                        <power/>
                        <ci>m</ci>
                        <cn bigmodel:units="dimensionless">3</cn>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_mh</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_Cr</ci>
                <apply>
                    <plus/>
                    <ci>i_Cr_</ci>
                    <ci>i_Cr_L</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_Cr_m_gate">
        <variable initial_value="0.447724" name="m" public_interface="out" units="dimensionless"/>
        <variable name="alpha_m" units="per_second"/>
        <variable name="beta_m" units="per_second"/>
        <variable name="m_infinity" units="dimensionless"/>
        <variable name="tau_m" units="second"/>
        <variable name="V" public_interface="in" units="millivolt"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable initial_value="1e-5" name="delta_m" units="millivolt"/>
        <variable name="E0_m" units="millivolt"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>m_infinity</ci>
                <apply>
                    <divide/>
                    <cn bigmodel:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <cn bigmodel:units="millivolt">42.0504</cn>
                                    </apply>
                                </apply>
                                <cn bigmodel:units="millivolt">8.3106</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E0_m</ci>
                <apply>
                    <plus/>
                    <ci>V</ci>
                    <cn bigmodel:units="millivolt">41</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>alpha_m</ci>
                <piecewise>
                    <piece>
                        <cn bigmodel:units="per_second">2000</cn>
                        <apply>
                            <lt/>
                            <apply>
                                <abs/>
                                <ci>E0_m</ci>
                            </apply>
                            <ci>delta_m</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn bigmodel:units="per_millivolt_second">200</cn>
                                <ci>E0_m</ci>
                            </apply>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <cn bigmodel:units="per_millivolt">0.1</cn>
                                        </apply>
                                        <ci>E0_m</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta_m</ci>
                <apply>
                    <times/>
                    <cn bigmodel:units="per_second">8000</cn>
                    <apply>
                        <exp/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn bigmodel:units="per_millivolt">0.056</cn>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>V</ci>
                                <cn bigmodel:units="millivolt">66</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_m</ci>
                <apply>
                    <divide/>
                    <cn bigmodel:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <ci>alpha_m</ci>
                        <ci>beta_m</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>m</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>m_infinity</ci>
                        <ci>m</ci>
                    </apply>
                    <ci>tau_m</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="i_Cr_h_gate">
        <variable initial_value="0.003058" name="h" public_interface="out" units="dimensionless"/>
