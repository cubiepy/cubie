                                </apply>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="dimensionless">0.369</cn>
                                    <apply>
                                        <exp/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <cn bigmodel:units="per_millivolt">0.12</cn>
                                            </apply>
                                            <apply>
                                                <plus/>
                                                <ci>V</ci>
                                                <cn bigmodel:units="millivolt">23.84</cn>
                                            </apply>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <cn bigmodel:units="second">2.98</cn>
