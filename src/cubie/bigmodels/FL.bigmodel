                            <cn bigmodel:units="dimensionless">65.17</cn>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <cn bigmodel:units="per_second">0.57</cn>
                                    <apply>
                                        <exp/>
