         <apply>
            <eq/>
            <ci>beta_x1</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <cn bigmodel:units="per_ms">0.0013</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <minus/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn bigmodel:units="mV">20</cn>
                           </apply>
                        </apply>
                        <cn bigmodel:units="mV">16.67</cn>
                     </apply>
                  </apply>
               </apply>
               <apply>
                  <plus/>
                  <cn bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <minus/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn bigmodel:units="mV">20</cn>
                           </apply>
                        </apply>
                        <cn bigmodel:units="mV">25</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>x1</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <ci>alpha_x1</ci>
                  <apply>
                     <minus/>
                     <cn bigmodel:units="dimensionless">1</cn>
                     <ci>x1</ci>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <ci>beta_x1</ci>
                  <ci>x1</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="time_independent_outward_flux">
      <variable name="i_Az1" units="uA_per_mm2" public_interface="out"/>
      <variable name="time" units="ms" public_interface="in"/>
      <variable name="V" units="mV" public_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_Az1</ci>
            <apply>
               <times/>
               <cn bigmodel:units="uA_per_mm2">0.0035</cn>
               <apply>
                  <plus/>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <cn bigmodel:units="dimensionless">4</cn>
                        <apply>
                           <minus/>
                           <apply>
                              <exp/>
                              <apply>
                                 <times/>
                                 <cn bigmodel:units="per_mV">0.04</cn>
                                 <apply>
                                    <plus/>
                                    <ci>V</ci>
                                    <cn bigmodel:units="mV">85</cn>
                                 </apply>
                              </apply>
                           </apply>
                           <cn bigmodel:units="dimensionless">1</cn>
                        </apply>
                     </apply>
                     <apply>
                        <plus/>
                        <apply>
                           <exp/>
                           <apply>
                              <times/>
                              <cn bigmodel:units="per_mV">0.08</cn>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn bigmodel:units="mV">53</cn>
                              </apply>
                           </apply>
                        </apply>
                        <apply>
                           <exp/>
                           <apply>
                              <times/>
                              <cn bigmodel:units="per_mV">0.04</cn>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn bigmodel:units="mV">53</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
                  <apply>
                     <divide/>
                     <apply>
                        <times/>
                        <cn bigmodel:units="per_mV">0.2</cn>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn bigmodel:units="mV">23</cn>
                        </apply>
                     </apply>
                     <apply>
                        <minus/>
                        <cn bigmodel:units="dimensionless">1</cn>
                        <apply>
                           <exp/>
                           <apply>
                              <times/>
                              <apply>
                                 <minus/>
                                 <cn bigmodel:units="per_mV">0.04</cn>
                              </apply>
                              <apply>
                                 <plus/>
                                 <ci>V</ci>
                                 <cn bigmodel:units="mV">23</cn>
                              </apply>
                           </apply>
                        </apply>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="drive_protocol">
      <variable name="Idrive" units="uA_per_mm2" public_interface="out">
</variable>
      <variable name="IdriveStart" units="ms" initial_value="10">
</variable>
      <variable name="IdriveEnd" units="ms" initial_value="50000"/>
      <variable name="IdriveAmplitude" units="uA_per_mm2" initial_value="0.5">
</variable>
      <variable name="IdrivePeriod" units="ms" initial_value="1000">
</variable>
      <variable name="IdrivePulseDuration" units="ms" initial_value="1">
</variable>
      <variable name="time" units="ms" public_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>Idrive</ci>
            <piecewise>
               <piece>
                  <ci>IdriveAmplitude</ci>
                  <apply>
                     <and/>
                     <apply>
                        <geq/>
                        <ci>time</ci>
                        <ci>IdriveStart</ci>
                     </apply>
                     <apply>
                        <leq/>
                        <ci>time</ci>
                        <ci>IdriveEnd</ci>
                     </apply>
                     <apply>
                        <leq/>
                        <apply>
                           <minus/>
                           <apply>
                              <minus/>
                              <ci>time</ci>
                              <ci>IdriveStart</ci>
                           </apply>
                           <apply>
                              <times/>
                              <apply>
                                 <floor/>
                                 <apply>
                                    <divide/>
                                    <apply>
                                       <minus/>
                                       <ci>time</ci>
                                       <ci>IdriveStart</ci>
                                    </apply>
                                    <ci>IdrivePeriod</ci>
                                 </apply>
                              </apply>
                              <ci>IdrivePeriod</ci>
                           </apply>
                        </apply>
                        <ci>IdrivePulseDuration</ci>
                     </apply>
                  </apply>
               </piece>
               <otherwise>
                  <cn bigmodel:units="uA_per_mm2">0</cn>
               </otherwise>
            </piecewise>
         </apply>
      </math>
   </component>
