<?xml version="1.0" encoding="utf-8"?>
<model name="BR_1977" xmlns="http://www.bigmodel.org/bigmodel/1.0#" xmlns:bigmodel="http://www.bigmodel.org/bigmodel/1.0#" xmlns:cmeta="http://www.bigmodel.org/metadata/1.0#">
   <units name="ms">
      <unit units="second" prefix="milli"/>
   </units>
   <units name="per_ms">
      <unit units="second" prefix="milli" exponent="-1"/>
   </units>
   <units name="mV">
      <unit units="volt" prefix="milli"/>
   </units>
   <units name="per_mV">
      <unit units="volt" prefix="milli" exponent="-1"/>
   </units>
   <units name="per_mV_ms">
      <unit units="mV" exponent="-1"/>
      <unit units="ms" exponent="-1"/>
   </units>
   <units name="mS_per_mm2">
      <unit units="siemens" prefix="milli"/>
      <unit units="metre" prefix="milli" exponent="-2"/>
   </units>
   <units name="uF_per_mm2">
      <unit units="farad" prefix="micro"/>
      <unit units="metre" prefix="milli" exponent="-2"/>
   </units>
   <units name="uA_per_mm2">
      <unit units="ampere" prefix="micro"/>
      <unit units="metre" prefix="milli" exponent="-2"/>
   </units>
   <units name="concentration_units">
      <unit units="mole" prefix="nano"/>
      <unit units="metre" prefix="milli" exponent="-3"/>
   </units>
   <units name="per_concentration_units">
      <unit units="concentration_units" exponent="-1"/>
   </units>
   <units name="coulomb_per_mole">
      <unit units="coulomb"/>
      <unit units="mole" exponent="-1"/>
   </units>
   <units name="per_mm">
      <unit units="metre" prefix="-3" exponent="-1"/>
   </units>
   <component name="environment">
      <variable name="time" units="ms" public_interface="out"/>
   </component>
   <component name="outerboundary">
      <variable name="V" units="mV" initial_value="-84.624" public_interface="out">
</variable>
      <variable name="C" units="uF_per_mm2" initial_value="0.01"/>
      <variable name="time" units="ms" public_interface="in"/>
      <variable name="i_Cr" units="uA_per_mm2" public_interface="in"/>
      <variable name="i_s" units="uA_per_mm2" public_interface="in"/>
      <variable name="i_x1" units="uA_per_mm2" public_interface="in"/>
      <variable name="i_Az1" units="uA_per_mm2" public_interface="in"/>
      <variable name="Idrive" units="uA_per_mm2" public_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>V</ci>
            </apply>
            <apply>
               <divide/>
                  <apply>
                     <minus/>
                     <ci>Idrive</ci>
                     <apply>
                        <plus/>
                        <ci>i_Cr</ci>
                        <ci>i_s</ci>
                        <ci>i_x1</ci>
                        <ci>i_Az1</ci>
                     </apply>
                  </apply>
               <ci>C</ci>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_flux">
      <variable name="i_Cr" units="uA_per_mm2" public_interface="out"/>
      <variable name="g_Cr" units="mS_per_mm2" initial_value="4e-2"/>
      <variable name="E_Cr" units="mV" initial_value="50"/>
      <variable name="g_Crc" units="mS_per_mm2" initial_value="3e-5"/>
      <variable name="time" units="ms" public_interface="in" private_interface="out"/>
      <variable name="V" units="mV" public_interface="in" private_interface="out"/>
      <variable name="m" units="dimensionless" private_interface="in"/>
      <variable name="h" units="dimensionless" private_interface="in"/>
      <variable name="j" units="dimensionless" private_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>i_Cr</ci>
            <apply>
               <times/>
               <apply>
                  <plus/>
                  <apply>
                     <times/>
                     <ci>g_Cr</ci>
                     <apply>
                        <power/>
                        <ci>m</ci>
                        <cn bigmodel:units="dimensionless">3</cn>
                     </apply>
                     <ci>h</ci>
                     <ci>j</ci>
                  </apply>
                  <ci>g_Crc</ci>
               </apply>
               <apply>
                  <minus/>
                  <ci>V</ci>
                  <ci>E_Cr</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
   <component name="crimson_flux_m_gate">
      <variable name="m" units="dimensionless" initial_value="0.011" public_interface="out"/>
      <variable name="alpha_m" units="per_ms"/>
      <variable name="beta_m" units="per_ms"/>
      <variable name="V" units="mV" public_interface="in"/>
      <variable name="time" units="ms" public_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_m</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <apply>
                     <minus/>
                     <cn bigmodel:units="per_mV_ms">1</cn>
                  </apply>
                  <apply>
                     <plus/>
                     <ci>V</ci>
                     <cn bigmodel:units="mV">47</cn>
                  </apply>
               </apply>
               <apply>
                  <minus/>
                  <apply>
                     <exp/>
                     <apply>
                        <times/>
                        <apply>
                           <minus/>
                           <cn bigmodel:units="per_mV">0.1</cn>
                        </apply>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn bigmodel:units="mV">47</cn>
                        </apply>
                     </apply>
                  </apply>
                  <cn bigmodel:units="dimensionless">1</cn>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_m</ci>
            <apply>
               <times/>
               <cn bigmodel:units="per_ms">40</cn>
               <apply>
                  <exp/>
                  <apply>
                     <times/>
                     <apply>
                        <minus/>
                        <cn bigmodel:units="per_mV">0.056</cn>
                     </apply>
                     <apply>
                        <plus/>
                        <ci>V</ci>
                        <cn bigmodel:units="mV">72</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>m</ci>
            </apply>
            <apply>
               <minus/>
               <apply>
                  <times/>
                  <ci>alpha_m</ci>
                  <apply>
                     <minus/>
                     <cn bigmodel:units="dimensionless">1</cn>
                     <ci>m</ci>
                  </apply>
               </apply>
               <apply>
                  <times/>
                  <ci>beta_m</ci>
                  <ci>m</ci>
               </apply>
            </apply>
         </apply>
      </math>
   </component>
