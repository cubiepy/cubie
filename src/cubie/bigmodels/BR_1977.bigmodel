                        <divide/>
                        <apply>
                           <minus/>
                           <apply>
                              <minus/>
                              <ci>V</ci>
                              <cn bigmodel:units="mV">5</cn>
                           </apply>
                        </apply>
                        <cn bigmodel:units="mV">13.89</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <ci>beta_d</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <cn bigmodel:units="per_ms">0.07</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <minus/>
                           <apply>
                              <plus/>
                              <ci>V</ci>
                              <cn bigmodel:units="mV">44</cn>
                           </apply>
                        </apply>
                        <cn bigmodel:units="mV">59</cn>
                     </apply>
                  </apply>
               </apply>
               <apply>
                  <plus/>
                  <cn bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn bigmodel:units="mV">44</cn>
                        </apply>
                        <cn bigmodel:units="mV">20</cn>
                     </apply>
                  </apply>
               </apply>
            </apply>
         </apply>
         <apply>
            <eq/>
            <apply>
               <diff/>
               <bvar>
                  <ci>time</ci>
               </bvar>
               <ci>d</ci>
            </apply>
            <apply>
               <minus/>
