   <component name="time_dependent_outward_flux_x1_gate">
      <variable name="x1" units="dimensionless" initial_value="0.0001" public_interface="out"/>
      <variable name="alpha_x1" units="per_ms"/>
      <variable name="beta_x1" units="per_ms"/>
      <variable name="V" units="mV" public_interface="in"/>
      <variable name="time" units="ms" public_interface="in"/>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
         <apply>
            <eq/>
            <ci>alpha_x1</ci>
            <apply>
               <divide/>
               <apply>
                  <times/>
                  <cn type="e-notation" bigmodel:units="per_ms">5<sep/>-4</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn bigmodel:units="mV">50</cn>
                        </apply>
                        <cn bigmodel:units="mV">12.1</cn>
                     </apply>
                  </apply>
               </apply>
               <apply>
                  <plus/>
                  <cn bigmodel:units="dimensionless">1</cn>
                  <apply>
                     <exp/>
                     <apply>
                        <divide/>
                        <apply>
                           <plus/>
                           <ci>V</ci>
                           <cn bigmodel:units="mV">50</cn>
